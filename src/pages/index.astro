const cardFoto = { src: '/images/foto-2-card-home-page.png', w: 1200, h: 666, cropW: 180, cropH: 186 };
const cardArtStyle = ({ x, y }) => {
  const { src, w, h, cropW, cropH } = cardFoto;
  return `background-image:url('${src}');background-size:${(w / cropW) * 100}% auto;` +
    `background-position:${(x / (w - cropW)) * 100}% ${(y / (h - cropH)) * 100}%`;
};
const decorFiori = (() => {
  const { src, w, h } = cardFoto;
  const cw = 330, ch = 200, x = 870, y = 22;
  return `background-image:url('${src}');background-size:${(w / cw) * 100}% auto;` +
    `background-position:${(x / (w - cw)) * 100}% ${(y / (h - ch)) * 100}%`;
})();

