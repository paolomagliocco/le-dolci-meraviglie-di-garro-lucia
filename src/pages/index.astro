const seoTitle = 'Biscotti decorati personalizzati | Dolci Meraviglie di Lucy Garro';
const seoDescription = 'Biscotti decorati artigianali personalizzati per compleanni, battesimi, baby shower, comunioni, matrimoni e lauree. Scopri i modelli e acquista su Etsy.';
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="https://www.esempio-biscotti.it/" />
    <style>
      :root {
        --cream: #fffaf5;
        --paper: #ffffff;
        --ink: #302820;
        --muted: #786b60;
        --rose: #e9b7bd;
        --rose-dark: #b76773;
        --beige: #efe4d7;
        --line: #eadfd5;
        --shadow: 0 14px 40px rgba(72, 48, 34, .08);
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: var(--cream);
        line-height: 1.6;
      }

      a { color: inherit; text-decoration: none; }
      .wrap { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255,250,245,.94);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand { font-family: Georgia, serif; font-size: 1.25rem; font-weight: 700; }
      .brand span { color: var(--rose-dark); }
      nav { display: flex; gap: 22px; font-size: .95rem; }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 999px;
        padding: 13px 20px;
        font-weight: 700;
        transition: .2s ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: var(--rose-dark); color: white; }
      .btn-secondary { background: white; border: 1px solid var(--line); }

      .hero {
        padding: 76px 0 56px;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr .95fr;
        gap: 48px;
        align-items: center;
      }
      .eyebrow {
        display: inline-block;
        background: var(--beige);
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
      }
      h1, h2, h3 { font-family: Georgia, serif; line-height: 1.1; margin-top: 0; }
      h1 { font-size: clamp(2.7rem, 6vw, 5.8rem); margin: 18px 0; }
      h1 em { color: var(--rose-dark); font-style: normal; }
      .lead { font-size: 1.12rem; color: var(--muted); max-width: 680px; }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

      .hero-card {
        min-height: 520px;
        border-radius: 36px;
        background:
          radial-gradient(circle at 20% 22%, rgba(255,255,255,.95) 0 6%, transparent 7%),
          radial-gradient(circle at 76% 28%, #f4c9cf 0 11%, transparent 12%),
          radial-gradient(circle at 32% 68%, #ead4b7 0 14%, transparent 15%),
          radial-gradient(circle at 72% 72%, #d8b7a2 0 13%, transparent 14%),
          linear-gradient(145deg, #f5e7dc, #f8d8dd);
        box-shadow: var(--shadow);
        display: grid;
        place-items: center;
        padding: 28px;
        position: relative;
        overflow: hidden;
              cursor: pointer;
        transition: transform .22s ease, box-shadow .22s ease;
      }

      .hero-card *,
      .hero-card .cookie-board,
      .hero-card .cookie-grid,
      .hero-card .cookie,
      .hero-card img {
        cursor: pointer;
      }

      .hero-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 22px 54px rgba(72,48,34,.16);
      }

      .hero-card:focus-visible {
        outline: 3px solid rgba(183,103,115,.42);
        outline-offset: 4px;
      }
      .cookie-board {
        width: min(420px, 92%);
        background: rgba(255,255,255,.84);
        border: 1px solid rgba(255,255,255,.8);
        border-radius: 30px;
        padding: 24px;
        box-shadow: 0 24px 60px rgba(95, 62, 48, .18);
        transform: rotate(-2deg);
      }
      .cookie-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }

    .cookie {
      aspect-ratio: 1;
      border-radius: 28px;
      background: #fff7ef;
      border: 1px solid #f2dfcf;
      overflow: hidden;
    }

    .cookie img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }


      .hero-gallery-dialog {
        position: relative;
        width: min(1180px, calc(100% - 28px));
        height: min(900px, 94vh);
        max-height: 94vh;
        padding: 0;
        border: 0;
        border-radius: 32px;
        overflow: hidden;
        background: linear-gradient(180deg, #fff8f5 0%, #f8ece7 100%);
        color: var(--ink);
        box-shadow: 0 32px 90px rgba(31,20,14,.30);
      }

      .hero-gallery-dialog::backdrop {
        background: rgba(36,27,23,.72);
        backdrop-filter: blur(6px);
      }

      .hero-gallery-modal {
        height: 100%;
        overflow-y: auto;
        padding: 42px 44px 50px;
        scrollbar-gutter: stable;
      }

      .hero-gallery-head {
        position: sticky;
        top: -42px;
        z-index: 8;
        margin: -42px -44px 34px;
        padding: 42px 88px 26px 44px;
        background: rgba(255,248,245,.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(183,103,115,.16);
      }

      .hero-gallery-head .eyebrow {
        margin-bottom: 10px;
      }

      .hero-gallery-head h2 {
        margin: 0 0 8px;
        font-size: clamp(2.5rem, 4.8vw, 4rem);
      }

      .hero-gallery-head p {
        margin: 0;
        color: var(--muted);
        font-size: 1.04rem;
      }

      .hero-featured-list {
        display: grid;
        gap: 26px;
      }

      .hero-featured-product {
        display: grid;
        grid-template-columns: 1.05fr .95fr;
        min-height: 460px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 30px;
        background: #fff;
        box-shadow: 0 16px 42px rgba(72,48,34,.10);
      }

      .hero-featured-image {
        min-width: 0;
        height: 460px;
        overflow: hidden;
        background: #f5eee8;
      }

      .hero-featured-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
      }

      .hero-featured-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 44px 42px;
        text-align: left;
      }

      .hero-featured-category {
        display: inline-flex;
        align-self: flex-start;
        margin-bottom: 13px;
        color: var(--rose-dark);
        font-size: .8rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .075em;
      }

      .hero-featured-content h3 {
        margin: 0 0 18px;
        font-size: clamp(2.1rem, 3.6vw, 3.35rem);
        line-height: 1.07;
      }

      .hero-featured-content p {
        margin: 0;
        max-width: 520px;
        color: var(--muted);
        font-size: 1.08rem;
        line-height: 1.75;
      }

      .hero-featured-note {
        display: inline-flex;
        align-self: flex-start;
        margin-top: 24px;
        padding: 8px 14px;
        border-radius: 999px;
        background: #f5e7e5;
        color: var(--rose-dark);
        font-size: .8rem;
        font-weight: 800;
        letter-spacing: .03em;
      }

      .hero-gallery-close {
        position: absolute;
        top: 17px;
        right: 18px;
        z-index: 30;
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        padding: 0;
        border: 2px solid rgba(255,255,255,.92);
        border-radius: 50%;
        background: var(--rose-dark);
        color: white;
        font-family: Arial, sans-serif;
        font-size: 1.9rem;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(48,40,32,.24);
        transition: transform .18s ease, background .18s ease;
      }

      .hero-gallery-close:hover {
        transform: scale(1.08);
        background: #9f5561;
      }

      @media (max-width: 760px) {
        .hero-gallery-dialog {
          width: calc(100% - 14px);
          height: 95vh;
          max-height: 95vh;
          border-radius: 22px;
        }

        .hero-gallery-modal {
          padding: 56px 14px 22px;
        }

        .hero-gallery-head {
          top: -56px;
          margin: -56px -14px 24px;
          padding: 58px 66px 20px 18px;
        }

        .hero-featured-product {
          grid-template-columns: 1fr;
          min-height: auto;
          border-radius: 24px;
        }

        .hero-featured-image {
          height: 330px;
        }

        .hero-featured-content {
