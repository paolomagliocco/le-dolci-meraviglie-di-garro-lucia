    <script>

      const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');

      const closeMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        mobileMenuToggle.setAttribute('aria-label', 'Apri menu di navigazione');
        mobileNav.classList.remove('is-open');
      };

      const openMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
        mobileMenuToggle.setAttribute('aria-label', 'Chiudi menu di navigazione');
        mobileNav.classList.add('is-open');
      };

      if (mobileMenuToggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
        mobileMenuToggle.addEventListener('click', (event) => {
          event.stopPropagation();
          mobileMenuToggle.getAttribute('aria-expanded') === 'true' ? closeMobileMenu() : openMobileMenu();
        });
        mobileNav.addEventListener('click', (event) => {
          event.stopPropagation();
          if (event.target instanceof HTMLAnchorElement) closeMobileMenu();
        });
        document.addEventListener('click', closeMobileMenu);
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMobileMenu();
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 900) closeMobileMenu();
        });
      }

      const categoryDialog = document.querySelector('#category-dialog');
      const categoryCards = document.querySelectorAll('[data-category-card]');
      const categoryTitle = document.querySelector('#category-dialog-title');
      const categoryDescription = document.querySelector('#category-dialog-description');
      const categoryProductsList = document.querySelector('#category-products-list');
      const categoryClose = document.querySelector('.category-close');
      const dataElement = document.querySelector('#category-products-data');

      const categoryProductsData = dataElement
        ? JSON.parse(dataElement.textContent ?? '[]')
        : [];

      function escapeHtml(value) {
        return String(value)
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#039;');
      }

      function openCategoryDialog(category) {
        const filtered = categoryProductsData.filter(
          (product) => product.categoria === category
        );

        categoryTitle.textContent = `Biscotti per ${category}`;
        categoryDescription.textContent =
          `Scorri tutti i biscotti disponibili per ${category.toLowerCase()}.`;

        if (filtered.length > 0) {
          categoryProductsList.innerHTML = filtered.map((product) => {
const whatsappUrl =
              `https://wa.me/393519425808?text=${encodeURIComponent(`Ciao Lucia, vorrei avere informazioni su: ${product.titolo}`)}`;

            return `
              <article class="category-product-row">
                <div class="category-product-row-image">
                  <img
                    src="${escapeHtml(product.immagine)}"
                    alt="${escapeHtml(product.titolo)}"
                    loading="lazy"
                  />
                </div>

                <div class="category-product-row-content">
                  <span class="product-category-label">
                    ${escapeHtml(category)}
                  </span>

                  <h4>${escapeHtml(product.titolo)}</h4>

                  <p class="category-product-description">
                    ${escapeHtml(product.descrizione)}
                  </p>

                  <div class="category-product-price-wrap">
                    <span class="category-product-price-label">Prezzo</span>
                    <span class="category-product-price">
                      ${escapeHtml(product.prezzo ?? 'Prezzo su richiesta')}
                    </span>
                  </div>

                  <div class="category-product-actions">
                    <a
                      class="btn btn-primary"
                      href="https://sweetwondersoflucy.etsy.com"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Acquista su Etsy
                    </a>

                    <a
                      class="btn btn-secondary"
                      href="${whatsappUrl}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Chiedi informazioni
                    </a>
                  </div>
                </div>
              </article>
            `;
          }).join('');
        } else {
          categoryProductsList.innerHTML = `
            <div class="category-empty">
              <h3>Nuovi modelli in arrivo</h3>
              <p>
                Stiamo preparando nuove proposte per questa categoria.
              </p>
            </div>
          `;
        }

        categoryDialog.showModal();
        categoryDialog.querySelector('.category-dialog-inner')?.scrollTo(0, 0);
      }

      categoryCards.forEach((card) => {
        card.style.cursor = 'pointer';

        card.addEventListener('mouseenter', () => {
          card.style.cursor = 'pointer';
        });

        card.addEventListener('click', () => {
          openCategoryDialog(card.dataset.category ?? '');
        });

        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openCategoryDialog(card.dataset.category ?? '');
          }
        });
      });

      categoryClose?.addEventListener('click', () => {
        categoryDialog.close();
      });

      categoryDialog?.addEventListener('click', (event) => {
        if (event.target === categoryDialog) {
          categoryDialog.close();
        }
      });
    </script>


    <script>
      const heroGalleryCard = document.querySelector('[data-hero-gallery]');
      const heroGalleryDialog = document.querySelector('#hero-gallery-dialog');
      const heroGalleryClose = document.querySelector('.hero-gallery-close');

      function openHeroGallery() {
        heroGalleryDialog?.showModal();
      }

      heroGalleryCard?.addEventListener('click', openHeroGallery);

      heroGalleryCard?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openHeroGallery();
        }
      });

      heroGalleryClose?.addEventListener('click', () => {
        heroGalleryDialog?.close();
      });

      heroGalleryDialog?.addEventListener('click', (event) => {
        if (event.target === heroGalleryDialog) {
          heroGalleryDialog.close();
        }
      });
    </script>


    <script>
      (() => {
        const root = document.querySelector('[data-maestro-carousel]');
        if (!root) return;
        const slides = [...root.querySelectorAll('.maestro-slide')];
        const dots = [...root.querySelectorAll('.maestro-dots button')];
        const caption = document.querySelector('[data-maestro-caption]');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let index = 0;
        let timer;

        const show = (i) => {
          index = (i + slides.length) % slides.length;
          slides.forEach((s, n) => s.classList.toggle('is-active', n === index));
          dots.forEach((d, n) => {
            d.classList.toggle('is-active', n === index);
            d.setAttribute('aria-selected', String(n === index));
          });
          if (caption) caption.innerHTML = slides[index].dataset.caption || '';
        };
        const start = () => { if (!reduce) { stop(); timer = setInterval(() => show(index + 1), 5000); } };
        const stop = () => clearInterval(timer);

        dots.forEach((d, n) => d.addEventListener('click', () => { show(n); start(); }));
        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', stop);
        root.addEventListener('focusout', start);
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
        start();
      })();
    </script>
  </body>
</html>
