---
const categorie = [
  { nome: 'Compleanni', emoji: '🎂', testo: 'Biscotti personalizzati per feste, età e temi speciali.' },
  { nome: 'Battesimi', emoji: '🕊️', testo: 'Set delicati per battesimi, bomboniere e sweet table.' },
  { nome: 'Baby shower', emoji: '🧸', testo: 'Orsetti, nuvole, stelline e colori su misura.' },
  { nome: 'Comunioni', emoji: '🤍', testo: 'Biscotti eleganti per una giornata da ricordare.' },
  { nome: 'Matrimoni', emoji: '💍', testo: 'Segnaposto e biscotti coordinati al tema delle nozze.' },
  { nome: 'Lauree', emoji: '🎓', testo: 'Tocco, pergamena e dettagli personalizzati.' },
];

const prodotti = [
  {
    nome: 'Biscotti Comunione e Cresima',
    categoria: 'Comunione',
    prezzo: 'da 3,80 €',
    immagine: '/images/biscotti-decorati-per-comunione-e-cresima.png'
  },
  {
    nome: 'Biscotti Cresima e Comunione',
    categoria: 'Cresima',
    prezzo: 'da 3,80 €',
    immagine: '/images/biscotti-decorati-per-cresima-e-comunione.png'
  },
  {
    nome: 'Biscotti Gender Reveal',
    categoria: 'Baby Shower',
    prezzo: 'da 3,50 €',
    immagine: '/images/biscotti-decorati-per-gender-reveal.png'
  },
  {
    nome: 'Biscotti Gender Reveal',
    categoria: 'Baby Shower',
    prezzo: 'da 3,50 €',
    immagine: '/images/biscotti-decorati-per-gender-reveal-2.png'
  }
];

const seoTitle = 'Biscotti Decorati Personalizzati | Le Dolci Meraviglie di Lucy Garro';
const seoDescription = 'Biscotti decorati e personalizzati artigianalmente per compleanni, battesimi, comunioni, cresime, baby shower, matrimoni, lauree ed eventi. Scopri Le Dolci Meraviglie di Lucy Garro e ordina online su Etsy.';
const canonicalUrl = 'https://www.ledolcimeravigliedigarrolucia.com/';
const etsyUrl = 'https://toppercrafts.etsy.com';
const whatsappUrl = 'https://wa.me/393519425808';
const ogImage = 'https://www.ledolcimeravigliedigarrolucia.com/images/biscotti-decorati-a-tema-rose-e-cuori.png';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Le Dolci Meraviglie di Lucy Garro',
  url: canonicalUrl,
  telephone: '+39 351 942 5808',
  image: ogImage,
  description: seoDescription,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Viale Zecchino 72A',
    addressLocality: 'Siracusa',
    addressRegion: 'Sicilia',
    addressCountry: 'IT'
  },
  sameAs: [etsyUrl]
};
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le Dolci Meraviglie di Lucy Garro" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Biscotti decorati personalizzati artigianali di Le Dolci Meraviglie di Lucy Garro" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <style>
      :root {
        --cream: #fffaf5;
        --paper: #ffffff;
        --ink: #302820;
        --muted: #786b60;
        --rose: #e9b7bd;
        --rose-dark: #b76773;
        --beige: #efe4d7;
        --line: #eadfd5;
        --shadow: 0 14px 40px rgba(72, 48, 34, .08);
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: var(--cream);
        line-height: 1.6;
      }

      a { color: inherit; text-decoration: none; }
      .wrap { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255,250,245,.94);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand { font-family: Georgia, serif; font-size: 1.25rem; font-weight: 700; }
      .brand span { color: var(--rose-dark); }
      nav { display: flex; gap: 22px; font-size: .95rem; }

      .mobile-menu-toggle {
        display: none;
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #fff;
        color: var(--ink);
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(72,48,34,.08);
      }

      .mobile-menu-toggle span,
      .mobile-menu-toggle span::before,
      .mobile-menu-toggle span::after {
        display: block;
        width: 22px;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition: transform .2s ease, opacity .2s ease;
      }

      .mobile-menu-toggle span {
        position: relative;
      }

      .mobile-menu-toggle span::before,
      .mobile-menu-toggle span::after {
        content: "";
        position: absolute;
        left: 0;
      }

      .mobile-menu-toggle span::before { top: -7px; }
      .mobile-menu-toggle span::after { top: 7px; }

      .mobile-menu-toggle[aria-expanded="true"] span {
        background: transparent;
      }

      .mobile-menu-toggle[aria-expanded="true"] span::before {
        top: 0;
        transform: rotate(45deg);
      }

      .mobile-menu-toggle[aria-expanded="true"] span::after {
        top: 0;
        transform: rotate(-45deg);
      }

      .mobile-nav-panel {
        display: none;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 999px;
        padding: 13px 20px;
        font-weight: 700;
        transition: .2s ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: var(--rose-dark); color: white; }
      .btn-secondary { background: white; border: 1px solid var(--line); }

      .hero {
        padding: 76px 0 56px;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr .95fr;
        gap: 48px;
        align-items: center;
      }
      .eyebrow {
        display: inline-block;
        background: var(--beige);
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
      }
      h1, h2, h3 { font-family: Georgia, serif; line-height: 1.1; margin-top: 0; }
      h1 { font-size: clamp(2.7rem, 6vw, 5.8rem); margin: 18px 0; }
      h1 em { color: var(--rose-dark); font-style: normal; }
      .lead { font-size: 1.12rem; color: var(--muted); max-width: 680px; }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

      .hero-card {
        min-height: 520px;
        border-radius: 36px;
        background:
          radial-gradient(circle at 20% 22%, rgba(255,255,255,.95) 0 6%, transparent 7%),
          radial-gradient(circle at 76% 28%, #f4c9cf 0 11%, transparent 12%),
          radial-gradient(circle at 32% 68%, #ead4b7 0 14%, transparent 15%),
          radial-gradient(circle at 72% 72%, #d8b7a2 0 13%, transparent 14%),
          linear-gradient(145deg, #f5e7dc, #f8d8dd);
        box-shadow: var(--shadow);
        display: grid;
        place-items: center;
        padding: 28px;
        position: relative;
        overflow: hidden;
      }
      .cookie-board {
        width: min(420px, 92%);
        background: rgba(255,255,255,.84);
        border: 1px solid rgba(255,255,255,.8);
        border-radius: 30px;
        padding: 24px;
        box-shadow: 0 24px 60px rgba(95, 62, 48, .18);
        transform: rotate(-2deg);
      }
      .cookie-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }

    .cookie {
      aspect-ratio: 1;
      border-radius: 28px;
      background: #fff7ef;
      border: 1px solid #f2dfcf;
      overflow: hidden;
    }

    .cookie img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

      section { padding: 72px 0; }
      .section-head { max-width: 760px; margin-bottom: 30px; }
      .section-head h2 { font-size: clamp(2rem, 4vw, 3.4rem); margin-bottom: 10px; }
      .section-head p { margin: 0; color: var(--muted); }

      .categories { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 24px;
        box-shadow: var(--shadow);
      }
      .category-icon { font-size: 2rem; }
      .card h3 { margin: 14px 0 8px; font-size: 1.4rem; }
      .card p { margin: 0; color: var(--muted); }

.products {display: grid;grid-template-columns: repeat(4, minmax(0, 1fr));gap: 18px;}

.products .card { min-width: 0;overflow: hidden;}

.product-thumb {width: 100%;height: 210px;border-radius: 18px;overflow: hidden;margin-bottom: 18px;background: #f6eee8;}

.product-thumb img { width: 100%;height: 100%;object-fit: cover;display: block;}


      .meta { font-size: .82rem; font-weight: 800; color: var(--rose-dark); text-transform: uppercase; }
      .price { font-weight: 800; margin-top: 10px; }

      .how {
        background: #f4ece4;
      }
      .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .step-no {
        width: 42px; height: 42px; border-radius: 50%; background: var(--rose-dark); color: white;
        display: grid; place-items: center; font-weight: 800; margin-bottom: 16px;
      }

      .cta {
        background: var(--rose-dark);
        color: white;
        border-radius: 32px;
        padding: 42px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
      }
      .cta h2 { margin: 0 0 8px; font-size: clamp(2rem, 4vw, 3.3rem); }
      .cta p { margin: 0; opacity: .88; }
      .cta .btn { background: white; color: var(--rose-dark); white-space: nowrap; }

      footer { padding: 40px 0 56px; color: var(--muted); font-size: .9rem; }

      @media (max-width: 900px) {
        .nav {
          min-height: 76px;
          gap: 14px;
        }

        .nav > nav,
        .nav > .btn-primary {
          display: none;
        }

        .brand {
          min-width: 0;
          font-size: clamp(1rem, 4vw, 1.25rem);
          line-height: 1.2;
        }

        .mobile-menu-toggle {
          display: inline-flex;
          margin-left: auto;
        }

        .mobile-nav-panel {
          display: block;
          position: absolute;
          top: calc(100% + 8px);
          left: 16px;
          right: 16px;
          padding: 12px;
          border: 1px solid var(--line);
          border-radius: 22px;
          background: rgba(255,250,245,.99);
          box-shadow: 0 22px 54px rgba(72,48,34,.18);
          transform: translateY(-8px);
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
          transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
        }

        .mobile-nav-panel.is-open {
          transform: translateY(0);
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
        }

        .mobile-nav-panel nav {
          display: grid;
          gap: 4px;
        }

        .mobile-nav-panel nav a {
          display: block;
          padding: 13px 14px;
          border-radius: 14px;
          font-size: 1rem;
          font-weight: 700;
        }

        .mobile-nav-panel nav a:hover,
        .mobile-nav-panel nav a:focus-visible {
          background: var(--beige);
          outline: none;
        }

        .mobile-nav-panel .mobile-etsy {
          width: 100%;
          margin-top: 10px;
        }

        .hero-grid { grid-template-columns: 1fr; }
        .hero-card { min-height: 400px; }
        .categories, .steps { grid-template-columns: repeat(2, 1fr); }
        .products { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 600px) {
        .wrap { width: min(100% - 28px, 1160px); }
        .hero { padding-top: 48px; }
        .categories, .steps, .products { grid-template-columns: 1fr; }
        .cta { flex-direction: column; align-items: flex-start; padding: 28px; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap nav">
        <a class="brand" href="/">Le Dolci Meraviglie<span> di Lucy Garro</span></a>

        <nav aria-label="Navigazione principale">
          <a href="/biscotti-decorati">Biscotti</a>
          <a href="/sweet-table">Sweet Table</a>
          <a href="/curriculum-lucia-garro">Curriculum</a>
          <a href="/certificazioni">Certificazioni</a>
          <a href="/#contatti">Contatti</a>
        </nav>

        <a class="btn btn-primary" href={etsyUrl} target="_blank" rel="noopener">Vai su Etsy per Acquistare Online</a>

        <button
          class="mobile-menu-toggle"
          type="button"
          aria-label="Apri menu di navigazione"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          data-mobile-menu-toggle
        >
          <span aria-hidden="true"></span>
        </button>

        <div class="mobile-nav-panel" id="mobile-nav-panel" data-mobile-nav>
          <nav aria-label="Navigazione mobile">
            <a href="/biscotti-decorati">Biscotti</a>
            <a href="/sweet-table">Sweet Table</a>
            <a href="/curriculum-lucia-garro">Curriculum</a>
            <a href="/certificazioni">Certificazioni</a>
            <a href="/#contatti">Contatti</a>
          </nav>
          <a class="btn btn-primary mobile-etsy" href={etsyUrl} target="_blank" rel="noopener">
            Vai su Etsy per Acquistare Online
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <span class="eyebrow">Biscotti artigianali personalizzati per ogni evento</span>
            <h1>Biscotti decorati personalizzati per rendere unico ogni evento</h1>
            <p class="lead">Biscotti decorati artigianali e personalizzati per compleanni, battesimi, baby shower, comunioni, cresime, matrimoni, lauree e occasioni speciali. Scegli il tema, personalizza i dettagli e completa l'ordine online su Etsy.</p>
            <div class="actions">
              <a class="btn btn-primary" href="#biscotti">Scopri i biscotti</a>
              <a class="btn btn-secondary" href={etsyUrl} target="_blank" rel="noopener">Acquista su Etsy</a>
            </div>
          </div>

          <div class="hero-card" aria-label="Anteprima biscotti decorati">
            <div class="cookie-board">
                <div class="cookie-grid">
                  <div class="cookie">
                    <img
                      src="/images/biscotti-decorati-a-tema-rose-e-cuori.png"
                      alt="Biscotti decorati per eventi a tema rose e cuori"
                    />
                  </div>

                  <div class="cookie">
                    <img
                      src="/images/biscotti-decorati-per-cresima-e-comunione.png"
                      alt="Biscotti decorati artigianali per Cresima e Comunione"
                    />
                  </div>

                  <div class="cookie">
                    <img
                      src="/images/biscotti-decorati-per-gender-reveal.png"
                      alt="Biscotti decorati personalizzati per Gender Reveal"
                    />
                  </div>

                  <div class="cookie">
                    <img
                      src="/images/biscotti-decorati-per-battesimo-a-tema-angeli.png"
                      alt="Biscotti decorati per Battesimo a tema angeli"
                    />
                  </div>
                </div>
            </div>
          </div>
        </div>
      </section>

      <section id="categorie">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Per ogni occasione</span>
            <h2>Trova il tema perfetto</h2>
            <p>Ogni categoria avrà una pagina SEO dedicata, pensata per intercettare ricerche Google specifiche.</p>
          </div>
          <div class="categories">
            {categorie.map((categoria) => (
              <article class="card">
                <div class="category-icon">{categoria.emoji}</div>
                <h3>{categoria.nome}</h3>
                <p>{categoria.testo}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="biscotti">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">In evidenza</span>
            <h2>I biscotti più richiesti</h2>
            <p>Ecco alcuni dei biscotti decorati per Gender Reveal e Baby Shower che puoi ordinare online su Etsy.</p>
          </div>
          <div class="products">
            {prodotti.map((prodotto) => (
              <article class="card">
                <div class="product-thumb">
                  <img
                    src={prodotto.immagine}
                    alt={`${prodotto.nome} - biscotti decorati ${prodotto.categoria}`}
                    loading="lazy"
                  />
                </div>
                <div class="meta">{prodotto.categoria}</div>
                <h3>{prodotto.nome}</h3>
                <div class="price">{prodotto.prezzo}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="how" id="come-funziona">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Semplice e veloce</span>
            <h2>Come funziona</h2>
          </div>
          <div class="steps">
            <article class="card"><div class="step-no">1</div><h3>Scegli il tema</h3><p>Esplora le categorie e trova il modello più adatto all'evento.</p></article>
            <article class="card"><div class="step-no">2</div><h3>Personalizza</h3><p>Nome, data, colori e dettagli possono essere adattati alla tua festa.</p></article>
            <article class="card"><div class="step-no">3</div><h3>Ordina su Etsy</h3><p>Il pagamento e la gestione dell'ordine avvengono sulla piattaforma Etsy.</p></article>
          </div>
        </div>
      </section>

      <section id="contatti">
        <div class="wrap">
          <div class="cta">
            <div>
              <h2>Hai un'idea particolare?</h2>
              <p>Scrivici per creare un set di biscotti completamente personalizzato. Le Dolci Meraviglie di Lucy Garro ha sede a Siracusa e realizza proposte per eventi e occasioni speciali.</p>
            </div>
            <a class="btn" href={whatsappUrl} target="_blank" rel="noopener">Contattaci su WhatsApp</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">© 2026 Le Dolci Meraviglie di Lucy Garro · Biscotti decorati artigianali · Privacy · Cookie</div>
    </footer>

    <script>
      const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');

      const closeMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        mobileMenuToggle.setAttribute('aria-label', 'Apri menu di navigazione');
        mobileNav.classList.remove('is-open');
      };

      const openMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
        mobileMenuToggle.setAttribute('aria-label', 'Chiudi menu di navigazione');
        mobileNav.classList.add('is-open');
      };

      if (mobileMenuToggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
        mobileMenuToggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
          isOpen ? closeMobileMenu() : openMobileMenu();
        });

        mobileNav.addEventListener('click', (event) => {
          event.stopPropagation();
          if (event.target instanceof HTMLAnchorElement) {
            closeMobileMenu();
          }
        });

        document.addEventListener('click', closeMobileMenu);

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMobileMenu();
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 900) closeMobileMenu();
        });
      }
    </script>
  </body>
</html>
