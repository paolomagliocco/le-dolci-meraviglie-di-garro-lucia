              <img
                src="/images/biscotti-decorati-per-compleanno-a-tema-arcobaleno.png"
                alt="Biscotti decorati per compleanno a tema arcobaleno"
              />
            </div>
            <div class="hero-featured-content">
              <span class="hero-featured-category">Compleanni</span>
              <h3>Biscotti a tema Arcobaleno</h3>
              <p>
                Biscotti decorati con arcobaleni e tonalità pastello, ideali per
                compleanni allegri e colorati. Il set può essere coordinato al tema
                della festa e personalizzato con dettagli dedicati al festeggiato.
              </p>
              <span class="hero-featured-note">Perfetti per feste e sweet table</span>
            </div>
          </article>

        </div>
      </div>
    </dialog>

    <footer>
      <div class="wrap">© 2026 Le Dolci Meraviglie di Lucy Garro · Biscotti decorati artigianali · Privacy · Cookie</div>
    </footer>

    <script>
      const categoryDialog = document.querySelector('#category-dialog');
      const categoryCards = document.querySelectorAll('[data-category-card]');
      const categoryTitle = document.querySelector('#category-dialog-title');
      const categoryDescription = document.querySelector('#category-dialog-description');
      const categoryProductsList = document.querySelector('#category-products-list');
      const categoryClose = document.querySelector('.category-close');
      const dataElement = document.querySelector('#category-products-data');

      const categoryProductsData = dataElement
        ? JSON.parse(dataElement.textContent ?? '[]')
        : [];

      function escapeHtml(value) {
        return String(value)
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#039;');
      }

      function openCategoryDialog(category) {
        const filtered = categoryProductsData.filter(
          (product) => product.categoria === category
        );

        categoryTitle.textContent = `Biscotti per ${category}`;
        categoryDescription.textContent =
          `Scorri tutti i biscotti disponibili per ${category.toLowerCase()}.`;

        if (filtered.length > 0) {
          categoryProductsList.innerHTML = filtered.map((product) => {
const whatsappUrl =
              `https://wa.me/393519425808?text=${encodeURIComponent(`Ciao Lucia, vorrei avere informazioni su: ${product.titolo}`)}`;

            return `
              <article class="category-product-row">
                <div class="category-product-row-image">
                  <img
                    src="${escapeHtml(product.immagine)}"
                    alt="${escapeHtml(product.titolo)}"
                    loading="lazy"
                  />
                </div>

                <div class="category-product-row-content">
                  <span class="product-category-label">
                    ${escapeHtml(category)}
                  </span>

                  <h4>${escapeHtml(product.titolo)}</h4>

                  <p class="category-product-description">
                    ${escapeHtml(product.descrizione)}
                  </p>

                  <div class="category-product-price-wrap">
                    <span class="category-product-price-label">Prezzo</span>
                    <span class="category-product-price">
                      ${escapeHtml(product.prezzo ?? 'Prezzo su richiesta')}
                    </span>
                  </div>

                  <div class="category-product-actions">
                    <a
                      class="btn btn-primary"
                      href="https://www.etsy.com/"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Acquista su Etsy
                    </a>

                    <a
                      class="btn btn-secondary"
                      href="${whatsappUrl}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Chiedi informazioni
                    </a>
                  </div>
                </div>
              </article>
            `;
          }).join('');
        } else {
          categoryProductsList.innerHTML = `
            <div class="category-empty">
              <h3>Nuovi modelli in arrivo</h3>
              <p>
                Stiamo preparando nuove proposte per questa categoria.
              </p>
            </div>
          `;
        }

        categoryDialog.showModal();
        categoryDialog.querySelector('.category-dialog-inner')?.scrollTo(0, 0);
      }

      categoryCards.forEach((card) => {
        card.style.cursor = 'pointer';

        card.addEventListener('mouseenter', () => {
          card.style.cursor = 'pointer';
        });

        card.addEventListener('click', () => {
          openCategoryDialog(card.dataset.category ?? '');
        });

        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openCategoryDialog(card.dataset.category ?? '');
          }
        });
      });

      categoryClose?.addEventListener('click', () => {
        categoryDialog.close();
      });

      categoryDialog?.addEventListener('click', (event) => {
        if (event.target === categoryDialog) {
          categoryDialog.close();
        }
      });
    </script>


    <script>
      const heroGalleryCard = document.querySelector('[data-hero-gallery]');
      const heroGalleryDialog = document.querySelector('#hero-gallery-dialog');
      const heroGalleryClose = document.querySelector('.hero-gallery-close');

      function openHeroGallery() {
        heroGalleryDialog?.showModal();
      }

      heroGalleryCard?.addEventListener('click', openHeroGallery);

      heroGalleryCard?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openHeroGallery();
        }
      });

      heroGalleryClose?.addEventListener('click', () => {
        heroGalleryDialog?.close();
      });

      heroGalleryDialog?.addEventListener('click', (event) => {
        if (event.target === heroGalleryDialog) {
          heroGalleryDialog.close();
        }
      });
    </script>

  </body>
</html>
