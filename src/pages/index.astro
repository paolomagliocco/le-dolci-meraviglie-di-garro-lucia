const seoTitle = 'Biscotti Decorati Personalizzati | Le Dolci Meraviglie';
const seoDescription = 'Biscotti decorati artigianalmente per compleanni, battesimi, comunioni, baby shower e matrimoni. Le Dolci Meraviglie di Lucy Garro, ordina su Etsy.';
const canonicalUrl = 'https://www.ledolcimeravigliedigarrolucia.com/';
const etsyUrl = 'https://sweetwondersoflucy.etsy.com';
const whatsappUrl = 'https://wa.me/393519425808';
const ogImage = 'https://www.ledolcimeravigliedigarrolucia.com/images/biscotti-decorati-a-tema-rose-e-cuori.png';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: 'Le Dolci Meraviglie di Lucy Garro',
  url: canonicalUrl,
  telephone: '+39 351 942 5808',
  image: ogImage,
  description: seoDescription,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Viale Zecchino 72A',
    addressLocality: 'Siracusa',
    addressRegion: 'Sicilia',
    addressCountry: 'IT'
  },
  areaServed: [
    { '@type': 'City', name: 'Siracusa' },
    { '@type': 'AdministrativeArea', name: 'Sicilia' },
    { '@type': 'Country', name: 'Italia' }
  ],
  sameAs: [etsyUrl]
};

const productListStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Biscotti decorati in evidenza',
  itemListElement: prodotti.map((prodotto, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: prodotto.nome,
      category: prodotto.categoria,
      image: `https://www.ledolcimeravigliedigarrolucia.com${prodotto.immagine}`,
      offers: {
        '@type': 'Offer',
        url: etsyUrl,
        priceCurrency: 'EUR',
        price: prodotto.prezzo.match(/[\d,]+/)[0].replace(',', '.'),
        availability: 'https://schema.org/InStock'
      }
    }
  }))
};
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le Dolci Meraviglie di Lucy Garro" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Biscotti decorati personalizzati artigianali di Le Dolci Meraviglie di Lucy Garro" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(productListStructuredData)}></script>
    <style>
      :root {
        --cream: #fffaf5;
        --paper: #ffffff;
        --ink: #302820;
        --muted: #786b60;
        --rose: #e9b7bd;
        --rose-dark: #b76773;
        --beige: #efe4d7;
        --line: #eadfd5;
        --shadow: 0 14px 40px rgba(72, 48, 34, .08);
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: var(--cream);
        line-height: 1.6;
      }

      a { color: inherit; text-decoration: none; }
      .wrap { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255,250,245,.94);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand { font-family: Georgia, serif; font-size: 1.25rem; font-weight: 700; }
      .brand span { color: var(--rose-dark); }
      nav { display: flex; gap: 22px; font-size: .95rem; }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 999px;
        padding: 13px 20px;
        font-weight: 700;
        transition: .2s ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: var(--rose-dark); color: white; }
      .btn-secondary { background: white; border: 1px solid var(--line); }

      .hero {
        padding: 76px 0 56px;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr .95fr;
        gap: 48px;
        align-items: center;
      }
      .eyebrow {
        display: inline-block;
        background: var(--beige);
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
      }
      h1, h2, h3 { font-family: Georgia, serif; line-height: 1.1; margin-top: 0; }
      h1 { font-size: clamp(2.7rem, 6vw, 5.8rem); margin: 18px 0; }
      h1 em { color: var(--rose-dark); font-style: normal; }
      .lead { font-size: 1.12rem; color: var(--muted); max-width: 680px; }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

      .hero-card {
        min-height: 520px;
        border-radius: 36px;
        background:
          radial-gradient(circle at 20% 22%, rgba(255,255,255,.95) 0 6%, transparent 7%),
          radial-gradient(circle at 76% 28%, #f4c9cf 0 11%, transparent 12%),
          radial-gradient(circle at 32% 68%, #ead4b7 0 14%, transparent 15%),
          radial-gradient(circle at 72% 72%, #d8b7a2 0 13%, transparent 14%),
          linear-gradient(145deg, #f5e7dc, #f8d8dd);
        box-shadow: var(--shadow);
        display: grid;
        place-items: center;
        padding: 28px;
        position: relative;
        overflow: hidden;
              cursor: pointer;
        transition: transform .22s ease, box-shadow .22s ease;
      }

      .hero-card *,
      .hero-card .cookie-board,
      .hero-card .cookie-grid,
      .hero-card .cookie,
      .hero-card img {
        cursor: pointer;
      }

      .hero-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 22px 54px rgba(72,48,34,.16);
      }

      .hero-card:focus-visible {
        outline: 3px solid rgba(183,103,115,.42);
