      .occ-title svg{position:absolute;left:45%;right:-12%;bottom:-.18em;width:67%;height:.3em;fill:none;stroke:#c98a93;stroke-width:2;stroke-linecap:round}
      .occasioni-head p{color:#3b2a24;max-width:680px}

      .occasioni .categories{gap:16px}
      .occ-card{
        display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:stretch;
        min-height:200px;padding:0;overflow:hidden;border-radius:18px;
        background:linear-gradient(135deg,#fdf1ef 0%,#fbe6e6 100%);
        border:2px solid #fff;box-shadow:0 10px 28px rgba(150,90,90,.12)
      }
      .occ-card:nth-child(2),.occ-card:nth-child(5){background:linear-gradient(135deg,#f6f1ee 0%,#f2ebe8 100%)}
      .occ-text{padding:22px 4px 22px 22px;display:flex;flex-direction:column;align-items:flex-start}
      .occ-icon{width:34px;height:34px;fill:none;stroke:#b0565f;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
      .occ-card h3{margin:8px 0 2px;color:#3b1f18;font-size:1.55rem}
      .occ-ribbon{width:110px;height:12px;margin:2px 0 10px;fill:none;stroke:#c98a93;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
      .occ-card p{color:#4a3028;font-size:.93rem;line-height:1.45}
      .occ-art{
        min-height:100%;background-repeat:no-repeat;
        -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 22%);mask-image:linear-gradient(90deg,transparent 0,#000 22%)
      }
      .occ-card:hover{border-color:#fff;box-shadow:0 18px 40px rgba(150,90,90,.2)}

      @media (max-width:900px){
        .occasioni-fiori{width:46vw;opacity:.7}
        .occasioni .categories{grid-template-columns:repeat(2,minmax(0,1fr))}
      }
      @media (max-width:600px){
        .occasioni .categories{grid-template-columns:1fr}
        .occ-card{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);min-height:180px}
        .occasioni-fiori{width:60vw;opacity:.45}
      }

      /* ===== Sezione "I biscotti più richiesti" ===== */
      .richiesti{background:linear-gradient(180deg,#fbf3ef 0%,#fffaf6 100%)}
      .richiesti-head h2{color:#3b1f18;margin:14px 0 18px}
      .richiesti-head p{color:#3b2a24;max-width:680px}
      .richiesti .products{gap:20px}
      .prod-card{
        padding:0;border-radius:20px;border:2px solid #fff;background:#fff;
        box-shadow:0 10px 28px rgba(150,90,90,.12);transition:transform .22s ease,box-shadow .22s ease
      }
      .prod-card:hover{transform:translateY(-5px);box-shadow:0 20px 44px rgba(150,90,90,.22)}
      .prod-link{display:flex;flex-direction:column;height:100%;color:inherit}
      .prod-link:focus-visible{outline:3px solid rgba(169,80,94,.4);outline-offset:3px;border-radius:20px}
      .prod-card .product-thumb{position:relative;height:auto;aspect-ratio:1;margin:0;border-radius:18px 18px 0 0;background:#f8ece8}
      .prod-card .product-thumb img{transition:transform .5s ease}
      .prod-card:hover .product-thumb img{transform:scale(1.06)}
      .prod-tag{
        position:absolute;left:12px;top:12px;padding:5px 12px;border-radius:999px;
        background:rgba(255,255,255,.92);color:#a9505e;font-family:Georgia,serif;font-size:.8rem;letter-spacing:.06em;
        text-transform:uppercase;box-shadow:0 4px 12px rgba(80,40,40,.12)
      }
      .prod-body{display:flex;flex-direction:column;align-items:center;text-align:center;flex:1;padding:18px 18px 20px;
        background:linear-gradient(180deg,#fff 0%,#fdf3f1 100%)}
      .prod-card h3{margin:0;color:#3b1f18;font-size:1.2rem;line-height:1.25}
      .prod-card .occ-ribbon{margin:8px 0 12px}
      .prod-foot{margin-top:auto;width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;
        padding-top:12px;border-top:1px dashed #ecd2d2}
      .prod-card .price{margin:0;font-family:Georgia,serif;font-size:1.15rem;font-weight:700;color:#a9505e}
      .prod-card .price small{margin-left:4px;font-family:Inter,system-ui,sans-serif;font-size:.75rem;font-weight:500;color:#8a6f68}
      .prod-cta{display:inline-flex;align-items:center;gap:4px;font-size:.88rem;font-weight:600;color:#3b1f18}
      .prod-cta .ico{width:16px;height:16px;transition:transform .2s ease}
      .prod-card:hover .prod-cta .ico{transform:translateX(3px)}
      .richiesti-more{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:38px}
      .richiesti-more .btn{padding:14px 28px;font-weight:600}
      .richiesti-more .btn-primary{background:#a9505e;box-shadow:0 10px 24px rgba(169,80,94,.25)}
      @media (max-width:600px){
        .richiesti .products{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
        .prod-body{padding:12px 10px 14px}
        .prod-card h3{font-size:1rem}
        .prod-card .occ-ribbon{width:80px}
        .prod-foot{flex-direction:column;gap:4px}
        .prod-tag{font-size:.68rem;padding:4px 9px;left:8px;top:8px}
        .richiesti-more .btn{flex:1 1 100%}
      }

      /* ===== Sezione formazione con Ceri Griffiths ===== */
      .maestro{
        position:relative;overflow:hidden;padding:96px 0;
        background:
          radial-gradient(ellipse 60% 70% at 0% 50%,rgba(244,207,210,.45),transparent 70%),
          radial-gradient(ellipse 50% 60% at 100% 0%,rgba(234,214,186,.45),transparent 70%),
          #fffaf6;
      }
      .maestro::before,.maestro::after{
        content:"";position:absolute;left:50%;width:min(1160px,calc(100% - 32px));height:1px;transform:translateX(-50%);
        background:linear-gradient(90deg,transparent,#d8b98a 20%,#d8b98a 80%,transparent)
      }
      .maestro::before{top:36px}.maestro::after{bottom:36px}
      .maestro-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:64px;align-items:start}
      @media (min-width:901px){.maestro-media{position:sticky;top:110px}}
      .maestro-media{margin:0;position:relative;isolation:isolate}
      .maestro-frame{position:relative;padding:12px;border-radius:28px;background:#fff;
        box-shadow:0 30px 70px rgba(120,70,60,.18)}
      .maestro-frame::before{
        content:"";position:absolute;inset:-12px;border:1.5px solid #d8b98a;border-radius:36px;z-index:-1;pointer-events:none
      }
      .maestro-frame img{display:block;width:100%;height:auto;border-radius:18px}
      .maestro-media figcaption{margin-top:22px;text-align:center;font-family:Georgia,serif;font-style:italic;color:#7a5a50;font-size:.98rem}
      .maestro-media figcaption em{color:#a9505e}

      .maestro-copy h2{margin:16px 0 6px;font-size:clamp(2rem,3.6vw,3.1rem);color:#3b1f18;line-height:1.1}
      .maestro-copy h2 em{font-style:italic;color:#a9505e}
      .maestro-ribbon{width:180px;height:16px;margin:4px 0 22px;fill:none;stroke:#c9a46b;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
      .maestro-copy p{color:#4a3028;margin:0 0 16px;line-height:1.75}
      .maestro-lead{font-family:Georgia,serif;font-size:1.2rem;line-height:1.6 !important;color:#3b1f18 !important}
      .maestro-lead strong{color:#a9505e;font-weight:700}

      .maestro-skills{list-style:none;padding:0;margin:26px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
      .maestro-skills li{
        display:flex;flex-direction:column;gap:6px;padding:16px 16px 14px;border-radius:16px;
        background:rgba(255,255,255,.75);border:1px solid #efdcd3;font-family:Georgia,serif;color:#3b1f18;font-size:.98rem;line-height:1.3
      }
      .maestro-skills span{font-family:Georgia,serif;font-style:italic;font-size:1.4rem;color:#c9a46b;line-height:1}

      .maestro-school{
        display:flex;gap:18px;align-items:flex-start;padding:22px 24px;border-radius:20px;
        background:linear-gradient(135deg,#fdf1ef,#fbe7e6);border:1px solid #f3d6d6;border-left:4px solid #a9505e
      }
      .maestro-crest{width:42px;height:42px;flex:0 0 42px;fill:none;stroke:#a9505e;stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round}
      .maestro-school h3{margin:0 0 6px;font-size:1.2rem;color:#3b1f18}
      .maestro-school p{margin:0;font-size:.94rem;line-height:1.65}

      .maestro-link{display:inline-flex;align-items:center;gap:8px;margin-top:24px;font-weight:600;color:#a9505e;
        border-bottom:1.5px solid rgba(169,80,94,.35);padding-bottom:2px;transition:gap .2s ease,border-color .2s ease}
      .maestro-link:hover{gap:12px;border-color:#a9505e}
      .maestro-link .ico{width:18px;height:18px}

      @media (max-width:900px){
        .maestro{padding:72px 0}
        .maestro-grid{grid-template-columns:1fr;gap:44px}
        .maestro-media{max-width:440px;margin:0 auto;width:calc(100% - 28px)}
      }
      @media (max-width:600px){
        .maestro-skills{grid-template-columns:1fr}
        .maestro-skills li{flex-direction:row;align-items:center;gap:12px}
        .maestro-school{flex-direction:column;gap:10px;padding:20px}
        .maestro-lead{font-size:1.08rem}
      }

      /* carousel foto sezione maestro */
      .maestro-slides{position:relative;aspect-ratio:1122/1402;border-radius:18px;overflow:hidden;clip-path:inset(0 round 18px);isolation:isolate;background:#f6ece6}
      .maestro-slides .maestro-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
        opacity:0;transform:scale(1.03);transition:opacity 1.1s ease,transform 6s ease}
      .maestro-slides .maestro-slide.is-active{opacity:1;transform:scale(1)}
      .maestro-dots{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);display:flex;gap:8px;
        padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.75);backdrop-filter:blur(4px)}
      .maestro-dots button{width:9px;height:9px;padding:0;border:0;border-radius:999px;background:#d9b3b8;cursor:pointer;transition:width .3s ease,background .3s ease}
      .maestro-dots button.is-active{width:24px;background:#a9505e}
      .maestro-dots button:focus-visible{outline:2px solid #a9505e;outline-offset:2px}
      @media (prefers-reduced-motion:reduce){.maestro-slides .maestro-slide{transition:opacity .3s ease;transform:none !important}}

      /* ===== Sezione "Come funziona" ===== */
      .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
      .how.how{
        position:relative;overflow:hidden;
        background:
          radial-gradient(ellipse 45% 60% at 100% 100%,rgba(244,207,210,.5),transparent 70%),
          radial-gradient(ellipse 40% 55% at 0% 0%,rgba(234,214,186,.4),transparent 70%),
          #fbf3ee;
      }
      .how-head{margin-left:auto;margin-right:auto;text-align:center}
      .how-head h2{color:#3b1f18;margin:14px 0 18px}
      .how-head p{color:#3b2a24;max-width:560px;margin:0 auto !important}
      .how-steps{list-style:none;padding:0;margin:44px 0 0;gap:28px;counter-reset:none;position:relative}
      .how-steps::before{
        content:"";position:absolute;top:66px;left:16%;right:16%;height:0;border-top:2px dashed #e2b9bd;z-index:0
      }
      .how-step{
        position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;
        padding:34px 26px 30px;border-radius:24px;background:linear-gradient(180deg,#fff 0%,#fffaf8 100%);border:2px solid #fff;
        box-shadow:0 14px 34px rgba(150,90,90,.12);transition:transform .25s ease,box-shadow .25s ease
      }
      .how-step:hover{transform:translateY(-6px);box-shadow:0 24px 48px rgba(150,90,90,.2)}
      .how-num{
        position:absolute;top:14px;right:20px;font-family:Georgia,serif;font-style:italic;font-size:2.6rem;line-height:1;
        color:transparent;-webkit-text-stroke:1px #d8b98a
      }
      .how-icon{
        width:64px;height:64px;display:grid;place-items:center;border-radius:50%;
        background:linear-gradient(135deg,#b9606d,#a9505e);box-shadow:0 0 0 8px #fbe6e6,0 12px 24px rgba(169,80,94,.3)
      }
      .how-icon svg{width:30px;height:30px;fill:none;stroke:#fff;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
      .how-step h3{margin:24px 0 2px;color:#3b1f18;font-size:1.45rem}
      .how-step .occ-ribbon{margin:6px 0 12px}
      .how-step p{margin:0;color:#4a3028;font-size:.96rem;line-height:1.6;max-width:260px}
      .how-link{margin-top:16px;font-size:.9rem;font-weight:600;color:#a9505e;border-bottom:1.5px solid rgba(169,80,94,.3);padding-bottom:1px}
      .how-link:hover{border-color:#a9505e}
      .how-cta{display:flex;justify-content:center;margin-top:44px}
      .how-cta .btn{padding:14px 30px;font-weight:600;background:#a9505e;box-shadow:0 10px 24px rgba(169,80,94,.25)}
      @media (max-width:900px){
        .how-steps{grid-template-columns:1fr;max-width:520px;margin-left:auto;margin-right:auto;gap:22px}
        .how-steps::before{top:40px;bottom:40px;left:50%;right:auto;height:auto;border-top:0;border-left:2px dashed #e2b9bd}
      }
      @media (max-width:600px){
        .how-step{padding:28px 20px 24px}
        .how-cta .btn{width:100%}
      }
      /* PC: foto hero più grande */
      @media (min-width:901px){
        .hero-home .hero-grid{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:12px}
        .hero-home h1{font-size:clamp(2.3rem,3.9vw,3.7rem)}
        /* la foto esce dal contenitore fino al bordo destro dello schermo (max 260px) */
        .hero-photo{margin-right:max(-260px,min(-16px,calc((1160px - 100vw) / 2)))}
      }
      @media (max-width:900px){
        .brand{align-items:flex-start;font-size:clamp(.95rem,4.2vw,1.25rem);min-width:0}
        .brand-text{white-space:normal}
        .hero-copy{min-width:0}
        .brand-ribbon{display:none}
        .hero-home{padding:32px 0 44px}
        .hero-home .hero-grid{grid-template-columns:1fr;gap:28px}
        .hero-photo{max-width:620px;margin:0 auto;width:100%}
        .hero-photo img{-webkit-mask-image:none;mask-image:none;border-radius:24px}
      }
      @media (max-width:600px){
        .hero-badge{font-size:.85rem;padding:8px 14px}
        .hero-home .actions .btn{flex:1 1 100%}
        .hero-photo{max-width:none;width:calc(100% + 32px);margin:0 -16px}
        .hero-photo img{border-radius:0}
        .hero-features{gap:12px}
        .hero-features li,.hero-features li:first-child{padding:0 14px 0 0}
        .hero-features li+li{border-left:0}
      }

    </style>

    <style is:global>
      /* Elementi creati dinamicamente via innerHTML nella dialog categorie */
      .category-products-list {
        display: grid;
        gap: 24px;
      }

      .category-product-row {
        display: grid;
        grid-template-columns: 1.08fr .92fr;
        width: 100%;
        min-height: 420px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #eadfd5;
        border-radius: 28px;
        box-shadow: 0 14px 40px rgba(72, 48, 34, .10);
      }

      .category-product-row-image {
        width: 100%;
        min-width: 0;
        height: 420px;
        overflow: hidden;
        background: #f6eee8;
      }

      .category-product-row-image img {
        width: 100%;
        height: 420px;
        display: block;
        object-fit: cover;
        object-position: center center;
      }

      .category-product-row-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 38px 34px;
        text-align: left;
      }

      .product-category-label {
        display: inline-flex;
        align-self: flex-start;
        color: #b76773;
        font-size: .78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .07em;
      }

      .category-product-row-content h4 {
        margin: 12px 0 14px;
        font-family: Georgia, serif;
        font-size: clamp(2rem, 3.5vw, 3.1rem);
        line-height: 1.08;
        color: #302820;
      }

      .category-product-description {
        margin: 0;
        color: #786b60;
        font-size: 1.02rem;
        line-height: 1.7;
      }

      .category-product-price-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
      }

      .category-product-price-label {
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: #aa9485;
      }

      .category-product-price {
        font-weight: 900;
        font-size: 1rem;
        color: #302820;
      }

      .category-product-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
      }

      .category-product-actions .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border-radius: 999px;
        font-size: .92rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform .2s ease;
      }

      .category-product-actions .btn:hover {
        transform: translateY(-2px);
      }

      .category-product-actions .btn-primary {
        background: #b76773;
        color: #ffffff;
        border: 1px solid #b76773;
      }

      .category-product-actions .btn-secondary {
        background: #ffffff;
        color: #302820;
        border: 1px solid #eadfd5;
      }

      .category-empty {
        padding: 42px 28px;
        text-align: center;
        background: rgba(255,255,255,.78);
        border: 1px solid rgba(183,103,115,.16);
        border-radius: 24px;
      }

      .category-empty h3 {
        margin: 0 0 8px;
        font-family: Georgia, serif;
        font-size: 1.5rem;
        color: #302820;
      }

      .category-empty p {
        margin: 0;
        color: #786b60;
      }

      @media (max-width: 700px) {
        .category-product-row {
          grid-template-columns: 1fr;
          min-height: auto;
        }

        .category-product-row-image,
        .category-product-row-image img {
          height: 280px;
        }

        .category-product-row-content {
          padding: 26px 22px 24px;
        }

        .category-product-row-content h4 {
          font-size: 2rem;
        }

        .category-product-actions {
          flex-direction: column;
        }

        .category-product-actions .btn {
          width: 100%;
        }
      }
    </style>
  </head>
