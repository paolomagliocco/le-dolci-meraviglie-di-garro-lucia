    <main>
      <section class="hero hero-home">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <span class="hero-badge">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c1.6 1.2 3.4.6 4.6 2s.4 3.3 1.6 4.6.8 3.2-.4 4.4-.8 3-2.4 3.8-3.2-.2-4.6.6-3-.6-4.2-1.8-2.6-1.6-2.6-3.4.8-3-.2-4.6 1-3 2.6-3.6 2.4-2.6 5.6-2Z"/><circle cx="9.5" cy="10" r=".8"/><circle cx="14.5" cy="11.5" r=".8"/><circle cx="11" cy="15" r=".8"/></svg>
              Biscotti artigianali personalizzati per ogni evento
