    <script>
      /* ---------- menu mobile (come nelle altre pagine) ---------- */
      const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');

      const closeMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        mobileMenuToggle.setAttribute('aria-label', 'Apri menu di navigazione');
        mobileNav.classList.remove('is-open');
      };

      const openMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
        mobileMenuToggle.setAttribute('aria-label', 'Chiudi menu di navigazione');
        mobileNav.classList.add('is-open');
      };

      if (mobileMenuToggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
        mobileMenuToggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
          isOpen ? closeMobileMenu() : openMobileMenu();
        });
        mobileNav.addEventListener('click', (event) => {
          event.stopPropagation();
          if (event.target instanceof HTMLAnchorElement) closeMobileMenu();
        });
        document.addEventListener('click', closeMobileMenu);
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMobileMenu();
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 900) closeMobileMenu();
        });
      }

      /* ---------- book fotografico + lightbox ---------- */
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Collega un contenitore a scorrimento orizzontale (una foto per "pagina") a frecce e contatore.
      const createSlider = (track, { prev, next, onChange }) => {
        const count = track.children.length;
        let current = 0;

        const indexFromScroll = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));

        const update = (index) => {
          current = Math.max(0, Math.min(count - 1, index));
          if (prev) prev.disabled = current === 0;
          if (next) next.disabled = current === count - 1;
          onChange(current);
        };

        // durante uno scorrimento comandato (frecce, miniature) si ignorano le posizioni intermedie
        let pending = -1;
        let pendingTimer = 0;

        const goTo = (index, smooth = true) => {
          const target = Math.max(0, Math.min(count - 1, index));
          pending = target;
          window.clearTimeout(pendingTimer);
          pendingTimer = window.setTimeout(() => { pending = -1; }, 900);
          track.scrollTo({ left: target * track.clientWidth, behavior: smooth && !reduceMotion ? 'smooth' : 'instant' });
          update(target);
        };

        let raf = 0;
        track.addEventListener('scroll', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const index = indexFromScroll();
            if (pending >= 0) {
              if (index === pending) pending = -1;
              return;
            }
            if (index !== current) update(index);
          });
        }, { passive: true });

        prev?.addEventListener('click', () => goTo(current - 1));
        next?.addEventListener('click', () => goTo(current + 1));
        window.addEventListener('resize', () => goTo(current, false));

        update(0);
        return { goTo, get current() { return current; } };
      };

      const book = document.querySelector('[data-book]');
      const lightbox = document.querySelector('[data-lightbox]');

      if (book instanceof HTMLElement && lightbox instanceof HTMLDialogElement) {
        const slides = Array.from(book.querySelectorAll('.book-slide'));
        const captions = slides.map((slide) => ({
          title: slide.getAttribute('data-title') ?? '',
          text: slide.querySelector('img')?.getAttribute('alt') ?? '',
        }));
        const thumbs = Array.from(book.querySelectorAll('[data-thumb]'));
        const bookTitle = book.querySelector('[data-book-title]');
        const bookText = book.querySelector('[data-book-text]');
        const bookCurrent = book.querySelector('[data-book-current]');

        const bookSlider = createSlider(book.querySelector('[data-book-track]'), {
          prev: book.querySelector('[data-book-prev]'),
          next: book.querySelector('[data-book-next]'),
          onChange: (i) => {
            if (bookTitle) bookTitle.textContent = captions[i].title;
            if (bookText) bookText.textContent = captions[i].text;
            if (bookCurrent) bookCurrent.textContent = String(i + 1);
            thumbs.forEach((thumb, t) => {
              thumb.setAttribute('aria-current', t === i ? 'true' : 'false');
              // scorre solo la striscia delle miniature (mai la pagina)
              const strip = thumb.closest('.book-thumbs');
              if (t === i && strip instanceof HTMLElement) {
                const item = thumb.parentElement ?? thumb;
                const left = item.offsetLeft - (strip.clientWidth - item.offsetWidth) / 2;
                strip.scrollTo({ left: Math.max(0, left), behavior: 'instant' });
              }
            });
          },
        });

        thumbs.forEach((thumb) => {
          thumb.addEventListener('click', () => bookSlider.goTo(Number(thumb.getAttribute('data-thumb'))));
        });

        // lightbox a schermo intero
        const lbTitle = lightbox.querySelector('[data-lb-title]');
        const lbText = lightbox.querySelector('[data-lb-text]');
        const lbCurrent = lightbox.querySelector('[data-lb-current]');
        const lbSlider = createSlider(lightbox.querySelector('[data-lb-track]'), {
          prev: lightbox.querySelector('[data-lb-prev]'),
          next: lightbox.querySelector('[data-lb-next]'),
          onChange: (i) => {
            if (lbTitle) lbTitle.textContent = captions[i].title;
            if (lbText) lbText.textContent = captions[i].text;
            if (lbCurrent) lbCurrent.textContent = String(i + 1);
          },
        });

        slides.forEach((slide, i) => {
          slide.addEventListener('click', () => {
            lbSlider.goTo(i, false); // aggiorna subito contatore e didascalia
            lightbox.showModal();
            document.body.style.overflow = 'hidden';
            requestAnimationFrame(() => lbSlider.goTo(i, false));
          });
        });

        const closeLightbox = () => { lightbox.close(); onLightboxClosed(); };
        lightbox.querySelector('[data-lb-close]')?.addEventListener('click', closeLightbox);
        // eseguita sia dal bottone/sfondo sia dall'evento close (tasto Esc); ripeterla non ha effetti
        const onLightboxClosed = () => {
          document.body.style.overflow = '';
          bookSlider.goTo(lbSlider.current, false); // il book resta sull'ultima foto vista
        };
        lightbox.addEventListener('close', onLightboxClosed);
        // clic sullo sfondo scuro (fuori dalla foto) per chiudere
        lightbox.addEventListener('click', (event) => {
          if (event.target instanceof HTMLElement && event.target.classList.contains('lb-slide')) closeLightbox();
        });

        document.addEventListener('keydown', (event) => {
          if (lightbox.open) {
            if (event.key === 'ArrowRight') lbSlider.goTo(lbSlider.current + 1);
            if (event.key === 'ArrowLeft') lbSlider.goTo(lbSlider.current - 1);
            return;
          }
          if (!book.contains(document.activeElement)) return;
          if (event.key === 'ArrowRight') { event.preventDefault(); bookSlider.goTo(bookSlider.current + 1); }
          if (event.key === 'ArrowLeft') { event.preventDefault(); bookSlider.goTo(bookSlider.current - 1); }
        });
      }
    </script>
  </body>
</html>
