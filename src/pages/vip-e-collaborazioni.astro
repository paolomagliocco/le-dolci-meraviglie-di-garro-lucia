---
const seoTitle = 'Personaggi VIP e Collaborazioni | Lucia Garro Cake Designer';
const seoDescription = 'Torte, biscotti decorati e cupcakes di Lucia Garro per personaggi VIP, volti dello spettacolo e location esclusive: tra questi il battesimo di Alessio, figlio di Luigi Mastroianni e Anna Scuderi.';
const canonicalUrl = 'https://www.ledolcimeravigliedigarrolucia.com/vip-e-collaborazioni';
const etsyUrl = 'https://sweetwondersoflucy.etsy.com';
const ogImage = 'https://www.ledolcimeravigliedigarrolucia.com/images/evento-mastroianni-scuderi-og.jpg';
const whatsappBase = 'https://wa.me/393519425808?text=';

/*
  Book fotografico dell'evento: per aggiungere o togliere foto basta modificare questo elenco.
  pos: punto da tenere al centro nelle miniature (es. 'center 30%' = un po' più in alto).
*/
type Foto = { src: string; titolo: string; didascalia: string; pos?: string };

const fotoBattesimo: Foto[] = [
  { src: '/images/evento-mastroianni-scuderi-2.webp', titolo: 'La famiglia', didascalia: 'Luigi Mastroianni e Anna Scuderi con il piccolo Alessio accanto alla torta del battesimo.', pos: 'center 25%' },
  { src: '/images/evento-mastroianni-scuderi-4.webp', titolo: 'Il momento della torta', didascalia: 'Mamma, papà e Alessio davanti alla torta a più piani con i fiori azzurri in zucchero.', pos: 'center 20%' },
  { src: '/images/evento-mastroianni-scuderi-1.webp', titolo: 'Gli ultimi ritocchi', didascalia: 'Lucia Garro rifinisce a mano i fiori in zucchero, accanto ai cupcakes pronti per la festa.' },
  { src: '/images/evento-mastroianni-scuderi-3.webp', titolo: 'L’allestimento', didascalia: 'La torta scenografica e le composizioni di biscotti decorati e cupcakes nei toni del bianco e dell’azzurro.' },
  { src: '/images/evento-mastroianni-scuderi-5.webp', titolo: 'Il battesimo di Alessio', didascalia: 'Il giardino dell’evento con il pannello “Il battesimo di Alessio” e il dessert table completo.', pos: 'center 70%' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Personaggi VIP e collaborazioni',
  url: canonicalUrl,
  description: seoDescription,
  image: ogImage,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Le Dolci Meraviglie di Lucy Garro',
    url: 'https://www.ledolcimeravigliedigarrolucia.com/'
  },
  about: {
    '@type': 'Person',
    name: 'Lucia Garro',
    jobTitle: 'Cake Designer e Pasticcera',
    address: { '@type': 'PostalAddress', addressLocality: 'Siracusa', addressCountry: 'IT' }
  },
  hasPart: {
    '@type': 'ImageGallery',
    name: 'Il battesimo di Alessio – Luigi Mastroianni e Anna Scuderi',
    image: fotoBattesimo.map((f) => ({
      '@type': 'ImageObject',
      contentUrl: `https://www.ledolcimeravigliedigarrolucia.com${f.src}`,
      caption: f.didascalia
    }))
  }
};

const waLink = (testo: string) => whatsappBase + encodeURIComponent(`Ciao Lucia, ${testo}`);
---

<html lang="it">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{seoTitle}</title>
<meta name="description" content={seoDescription} />
<meta name="robots" content="index,follow,max-image-preview:large" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:locale" content="it_IT" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Le Dolci Meraviglie di Lucy Garro" />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="Luigi Mastroianni e Anna Scuderi con il piccolo Alessio al battesimo, torta di Lucia Garro" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={seoDescription} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <style>
      :root {
        --cream: #fffaf6;
        --ink: #3b1f18;
        --text: #4a3028;
        --muted: #7a5a50;
        --rose: #a9505e;
        --rose-soft: #f4cfd2;
        --rose-line: #c98a93;
        --gold: #d8b98a;
        --gold-dark: #c9a46b;
        --line: #eadfd5;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); background: var(--cream); line-height: 1.6; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; }
      .wrap { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }
      h1, h2, h3 { font-family: Georgia, serif; line-height: 1.12; margin-top: 0; color: var(--ink); }
      section { padding: 88px 0; }

      /* ---------- icone e decori condivisi ---------- */
      .ico{width:20px;height:20px;flex:0 0 auto;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
      .ribbon{display:block;width:120px;height:12px;fill:none;stroke:var(--rose-line);stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
      .eyebrow{
        position:relative;display:inline-block;margin:0 22px;padding:6px 18px;border-radius:999px;
        background:var(--rose-soft);color:#5a2a2a;font-family:Georgia,serif;font-size:.86rem;letter-spacing:.12em;text-transform:uppercase
      }
      .eyebrow::before,.eyebrow::after{content:"";position:absolute;top:50%;width:12px;height:12px;transform:translateY(-50%)}
      .eyebrow::before{left:-20px;background:
        linear-gradient(-20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 0/100% 50% no-repeat,
        linear-gradient(#c97c86,#c97c86) 0 60%/100% 1.5px no-repeat,
        linear-gradient(20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 100%/100% 50% no-repeat}
      .eyebrow::after{right:-20px;background:
        linear-gradient(20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 0/100% 50% no-repeat,
        linear-gradient(#c97c86,#c97c86) 0 60%/100% 1.5px no-repeat,
        linear-gradient(-20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 100%/100% 50% no-repeat}
      .swash{position:relative;display:inline-block}
      .swash svg{position:absolute;left:10%;bottom:-.18em;width:80%;height:.3em;fill:none;stroke:var(--rose-line);stroke-width:2;stroke-linecap:round}
      .section-head{max-width:720px;margin:0 auto 48px;text-align:center}
      .section-head h2{font-size:clamp(2.1rem,4vw,3.3rem);margin:16px 0 20px}
      .section-head h2 em{font-style:italic;color:var(--rose)}
      .section-head p{margin:0 auto;color:var(--text);max-width:620px}

      /* ---------- bottoni ---------- */
      .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;padding:14px 26px;font-weight:600;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}
      .btn:hover{transform:translateY(-1px)}
      .btn-primary{background:var(--rose);color:#fff;box-shadow:0 10px 24px rgba(169,80,94,.25)}
      .btn-outline{background:transparent;border:1.5px solid var(--rose);color:var(--ink)}
      .btn-outline:hover{background:#fff}
      .btn-light{background:#fff;color:var(--rose);box-shadow:0 10px 24px rgba(60,20,20,.18)}

      /* ---------- header (come nelle altre pagine) ---------- */
      header{position:sticky;top:0;z-index:20;background:rgba(255,250,245,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
      .nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}
      .brand{display:inline-flex;flex-direction:column;align-items:center;font-family:Georgia,serif;font-weight:700;color:var(--ink);font-size:1.4rem;line-height:1.15}
      .brand-text{white-space:nowrap}
      .brand-text span{color:var(--rose)}
      .brand-ribbon{width:min(180px,80%);height:14px;margin-top:4px;fill:none;stroke:var(--rose);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
      .nav>nav{display:flex;gap:clamp(14px,2vw,26px);font-size:.95rem}
      .nav>nav a{font-family:Georgia,serif;color:var(--ink);white-space:nowrap}
      .nav>nav a:hover,.nav>nav a[aria-current="page"]{color:var(--rose)}
      .nav>nav a[aria-current="page"]{text-decoration:underline;text-decoration-color:var(--rose-line);text-underline-offset:6px}
      .header-etsy{padding:12px 20px;white-space:nowrap}
      @media (max-width:1180px){.brand{font-size:1.15rem}.header-etsy{font-size:.9rem;padding:11px 16px}}
      @media (min-width:901px) and (max-width:1100px){.nav{gap:14px}.brand{font-size:1.02rem}.nav>nav{gap:14px}.nav>nav a{font-size:.88rem}.header-etsy{font-size:.84rem;padding:10px 14px}.header-etsy .ico{display:none}}
      /* con 7 voci di menu: header un po' più largo e, fino a 1480px, bottone Etsy solo icona (testo come tooltip) */
      .nav.wrap{width:min(1440px,calc(100% - 32px))}
      @media (min-width:901px) and (max-width:1480px){.header-etsy{width:46px;height:46px;flex:0 0 46px;padding:0;gap:0;font-size:0}.header-etsy .ico{display:block;width:20px;height:20px}}
      @media (min-width:901px) and (max-width:980px){.nav,.nav>nav{gap:10px}.nav>nav a{font-size:.82rem}.brand{font-size:.95rem}}

      .mobile-menu-toggle{
        display:none;width:46px;height:46px;flex:0 0 46px;align-items:center;justify-content:center;
        padding:0;border:1px solid var(--line);border-radius:14px;background:#fff;color:var(--ink);
        cursor:pointer;box-shadow:0 8px 22px rgba(72,48,34,.08)
      }
      .mobile-menu-toggle span,.mobile-menu-toggle span::before,.mobile-menu-toggle span::after{
        display:block;width:22px;height:2px;border-radius:2px;background:currentColor;transition:transform .2s ease,opacity .2s ease
      }
      .mobile-menu-toggle span{position:relative}
      .mobile-menu-toggle span::before,.mobile-menu-toggle span::after{content:"";position:absolute;left:0}
      .mobile-menu-toggle span::before{top:-7px}.mobile-menu-toggle span::after{top:7px}
      .mobile-menu-toggle[aria-expanded="true"] span{background:transparent}
      .mobile-menu-toggle[aria-expanded="true"] span::before{top:0;transform:rotate(45deg)}
      .mobile-menu-toggle[aria-expanded="true"] span::after{top:0;transform:rotate(-45deg)}
      .mobile-nav-panel{display:none}

      /* ---------- intro ---------- */
      .vip-hero{
        position:relative;overflow:hidden;padding:72px 0 80px;text-align:center;
        background:linear-gradient(100deg,#fdf6f1 0%,#fbeee8 45%,#f6dfdc 100%)
      }
      .vip-hero::before,.vip-hero::after{content:"";position:absolute;border-radius:50%;pointer-events:none}
      .vip-hero::before{width:460px;height:460px;left:-160px;top:-180px;background:radial-gradient(circle,rgba(244,207,210,.7),transparent 70%)}
      .vip-hero::after{width:380px;height:380px;right:-140px;bottom:-200px;background:radial-gradient(circle,rgba(216,185,138,.35),transparent 70%)}
      .vip-hero .wrap{position:relative;max-width:820px}
      .vip-hero h1{font-size:clamp(2.4rem,4.6vw,4rem);margin:22px 0 24px;letter-spacing:-.01em}
      .vip-hero h1 em{font-style:italic;color:var(--rose)}
      .vip-hero .lead{font-family:Georgia,serif;font-style:italic;font-size:1.18rem;line-height:1.65;color:var(--ink);margin:0 auto 16px;max-width:700px}
      .vip-hero p{color:var(--text);margin:0 auto;max-width:700px;font-size:1.02rem;line-height:1.75}
      .hero-pills{list-style:none;padding:0;margin:30px 0 0;display:flex;flex-wrap:wrap;justify-content:center;gap:12px}
      .hero-pills li{
        display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:999px;background:rgba(255,255,255,.85);
        border:1px solid #f1d6d6;box-shadow:0 8px 20px rgba(150,90,90,.08);font-family:Georgia,serif;font-size:.95rem
      }
      .hero-pills .ico{width:18px;height:18px;color:var(--gold-dark)}

      /* ---------- evento: book fotografico + racconto ---------- */
      .event{background:linear-gradient(180deg,#fbf3ef 0%,#fffaf6 100%)}
      .event-grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:56px;align-items:start}

      .book{position:relative;padding:14px;border-radius:30px;background:#fff;box-shadow:0 30px 70px rgba(120,70,60,.18);isolation:isolate}
      .book::before{content:"";position:absolute;inset:-12px;border:1.5px solid var(--gold);border-radius:38px;z-index:-1;pointer-events:none}
      .book-stage{position:relative;border-radius:20px;overflow:hidden;background:#f3e6e1}
      .book-track{
        display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;
        aspect-ratio:4/5;overscroll-behavior-x:contain
      }
      .book-track::-webkit-scrollbar{display:none}
      .book-slide{
        position:relative;flex:0 0 100%;scroll-snap-align:center;scroll-snap-stop:always;margin:0;
        overflow:hidden;cursor:zoom-in;border:0;padding:0;background:none;display:block
      }
      .book-slide::before{
        content:"";position:absolute;inset:-30px;background-image:var(--bg);background-size:cover;background-position:center;
        filter:blur(26px) saturate(1.1);opacity:.75;transform:scale(1.1)
      }
      .book-slide img{position:relative;display:block;width:100%;height:100%;object-fit:contain}
      .book-slide:focus-visible{outline:3px solid var(--rose);outline-offset:-6px}
      .zoom-hint{
        position:absolute;right:14px;top:14px;z-index:2;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;
        background:rgba(59,31,24,.62);backdrop-filter:blur(6px);color:#fff;font-size:.76rem;font-weight:600;pointer-events:none
      }
      .zoom-hint .ico{width:14px;height:14px}
      .book-counter{
        position:absolute;left:14px;top:14px;z-index:2;padding:5px 12px;border-radius:999px;background:rgba(255,255,255,.93);
        color:var(--rose);font-family:Georgia,serif;font-size:.82rem;letter-spacing:.06em;box-shadow:0 4px 12px rgba(80,40,40,.12);pointer-events:none
      }
      .book-arrow{
        position:absolute;top:50%;z-index:3;width:46px;height:46px;display:grid;place-items:center;margin-top:-23px;padding:0;
        border:0;border-radius:50%;background:rgba(255,255,255,.92);color:var(--rose);cursor:pointer;
        box-shadow:0 10px 24px rgba(80,40,40,.2);transition:transform .2s ease,opacity .2s ease,background .2s ease
      }
      .book-arrow:hover{background:#fff;transform:scale(1.06)}
      .book-arrow:disabled{opacity:0;pointer-events:none}
      .book-arrow:focus-visible{outline:2px solid var(--rose);outline-offset:3px}
      .book-arrow.prev{left:14px}.book-arrow.next{right:14px}
      .book-arrow .ico{width:22px;height:22px;stroke-width:2}

      .book-caption{padding:18px 8px 6px;text-align:center;min-height:96px}
      .book-caption h3{font-size:1.25rem;margin:0 0 6px}
      .book-caption p{margin:0;color:var(--text);font-size:.93rem;line-height:1.55}

      .book-thumbs{position:relative;
        list-style:none;margin:8px 0 0;padding:6px 4px 8px;display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:thin
      }
      .book-thumbs li{flex:0 0 auto;scroll-snap-align:center}
      .book-thumbs button{
        display:block;width:72px;height:90px;padding:0;border:2px solid transparent;border-radius:14px;overflow:hidden;cursor:pointer;
        background:#f3e6e1;opacity:.6;transition:opacity .2s ease,border-color .2s ease,transform .2s ease
      }
      .book-thumbs button:hover{opacity:.9}
      .book-thumbs button[aria-current="true"]{opacity:1;border-color:var(--rose);transform:translateY(-2px)}
      .book-thumbs button:focus-visible{outline:2px solid var(--rose);outline-offset:2px}
      .book-thumbs img{display:block;width:100%;height:100%;object-fit:cover}

      .story .eyebrow{margin-left:22px}
      .story h2{font-size:clamp(2.1rem,4vw,3.1rem);margin:18px 0 20px}
      .story h2 em{font-style:italic;color:var(--rose)}
      .story .lead{font-family:Georgia,serif;font-style:italic;font-size:1.12rem;line-height:1.65;margin:0 0 16px}
      .story p{color:var(--text);margin:0 0 16px;line-height:1.75}
      .story p strong{color:var(--ink)}
      .event-facts{
        list-style:none;margin:26px 0 0;padding:20px 22px;display:grid;gap:14px;border-radius:22px;
        background:rgba(255,255,255,.85);border:2px solid #fff;box-shadow:0 10px 28px rgba(150,90,90,.1)
      }
      .event-facts li{display:flex;gap:14px;align-items:flex-start}
      .fact-icon{width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#b9606d,#a9505e);box-shadow:0 0 0 5px #fbe6e6}
      .fact-icon svg{width:18px;height:18px;fill:none;stroke:#fff;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
      .event-facts strong{display:block;font-family:Georgia,serif;font-size:.98rem;line-height:1.3;color:var(--ink)}
      .event-facts div span{display:block;color:var(--muted);font-size:.88rem;line-height:1.5}
      .story-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}

      /* ---------- collaborazioni ---------- */
      .collab-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
      .collab-card{
        padding:30px 26px;border-radius:24px;background:linear-gradient(180deg,#fff 0%,#fdf3f1 100%);border:2px solid #fff;text-align:center;
        box-shadow:0 10px 28px rgba(150,90,90,.12)
      }
      .collab-card .fact-icon{width:52px;height:52px;margin:0 auto 18px}
      .collab-card .fact-icon svg{width:24px;height:24px}
      .collab-card h3{font-size:1.25rem;margin:0 0 10px}
      .collab-card p{margin:0;color:var(--text);font-size:.93rem;line-height:1.6}

      /* ---------- lightbox ---------- */
      .lightbox{
        width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;margin:0;padding:0;border:0;background:transparent;color:#fff;overflow:hidden
      }
      .lightbox::backdrop{background:rgba(30,14,12,.92);backdrop-filter:blur(4px)}
      .lightbox[open]{display:flex;flex-direction:column;animation:lb-in .28s ease}
      @keyframes lb-in{from{opacity:0}to{opacity:1}}
      .lb-top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px}
      .lb-counter{font-family:Georgia,serif;letter-spacing:.08em;opacity:.85}
      .lb-close{
        width:46px;height:46px;display:grid;place-items:center;padding:0;border:1px solid rgba(255,255,255,.35);border-radius:50%;
        background:rgba(255,255,255,.08);color:#fff;cursor:pointer;transition:transform .25s ease,background .2s ease
      }
      .lb-close:hover{background:rgba(255,255,255,.18);transform:rotate(90deg)}
      .lb-close .ico{width:22px;height:22px;stroke-width:2}
      .lb-body{position:relative;flex:1;min-height:0}
      .lb-track{display:flex;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
      .lb-track::-webkit-scrollbar{display:none}
      .lb-slide{flex:0 0 100%;height:100%;margin:0;padding:0 clamp(12px,6vw,90px);display:flex;align-items:center;justify-content:center;scroll-snap-align:center;scroll-snap-stop:always}
      .lb-slide img{max-width:100%;max-height:100%;object-fit:contain;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.45)}
      .lb-arrow{
        position:absolute;top:50%;z-index:2;width:52px;height:52px;margin-top:-26px;display:grid;place-items:center;padding:0;
        border:1px solid rgba(255,255,255,.35);border-radius:50%;background:rgba(255,255,255,.1);color:#fff;cursor:pointer;transition:background .2s ease,opacity .2s ease
      }
      .lb-arrow:hover{background:rgba(255,255,255,.22)}
      .lb-arrow:disabled{opacity:0;pointer-events:none}
      .lb-arrow.prev{left:16px}.lb-arrow.next{right:16px}
      .lb-arrow .ico{width:24px;height:24px;stroke-width:2}
      .lb-caption{padding:14px 20px 22px;text-align:center}
      .lb-caption h3{color:#fff;font-size:1.15rem;margin:0 0 4px}
      .lb-caption p{margin:0 auto;max-width:640px;opacity:.82;font-size:.92rem}

      /* ---------- CTA finale ---------- */
      .final{padding:88px 0}
      .cta{
        position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:28px;
        padding:52px 56px;border-radius:32px;color:#fff;
        background:radial-gradient(ellipse 60% 120% at 100% 0%,rgba(255,255,255,.18),transparent 60%),linear-gradient(120deg,#b9606d 0%,#a9505e 55%,#93404e 100%);
        box-shadow:0 26px 60px rgba(169,80,94,.3)
      }
      .cta::before{content:"";position:absolute;inset:12px;border:1px solid rgba(255,255,255,.35);border-radius:24px;pointer-events:none}
      .cta>div:first-child{min-width:0;position:relative}
      .cta h2{color:#fff;margin:0 0 8px;font-size:clamp(1.9rem,3.6vw,2.9rem)}
      .cta p{margin:0;opacity:.92;max-width:560px}
      .cta .ribbon{stroke:rgba(255,255,255,.7);margin:0 0 14px}
      .cta-actions{display:flex;flex-wrap:wrap;gap:12px;position:relative}
      .cta .btn{white-space:nowrap}
      .cta .btn-ghost{border:1.5px solid rgba(255,255,255,.7);color:#fff}
      .cta .btn-ghost:hover{background:rgba(255,255,255,.12)}

      footer{padding:36px 0 56px;color:var(--muted);font-size:.9rem;border-top:1px solid var(--line)}

      .whatsapp-floating{
        position:fixed;right:20px;bottom:20px;z-index:30;display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:999px;
        background:#25d366;color:#fff;font-weight:700;font-size:.92rem;box-shadow:0 12px 28px rgba(37,211,102,.35);transition:transform .2s ease
      }
      .whatsapp-floating:hover{transform:translateY(-2px)}
      .whatsapp-floating svg{width:20px;height:20px;fill:#fff}

      /* ---------- responsive ---------- */
      @media (max-width:900px){
        section{padding:68px 0}
        .nav{min-height:76px;gap:14px}
        .nav>nav,.nav>.btn-primary{display:none}
        .brand{align-items:flex-start;font-size:clamp(.95rem,4.2vw,1.25rem);min-width:0}
        .brand-text{white-space:normal}
        .brand-ribbon{display:none}
        .mobile-menu-toggle{display:inline-flex;margin-left:auto}
        .mobile-nav-panel{
          display:block;position:absolute;top:calc(100% + 8px);left:16px;right:16px;padding:12px;
          border:1px solid var(--line);border-radius:22px;background:rgba(255,250,245,.99);
          box-shadow:0 22px 54px rgba(72,48,34,.18);transform:translateY(-8px);opacity:0;
          visibility:hidden;pointer-events:none;transition:opacity .2s ease,transform .2s ease,visibility .2s ease
        }
        .mobile-nav-panel.is-open{transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
        .mobile-nav-panel nav{display:grid;gap:4px}
        .mobile-nav-panel nav a{display:block;padding:13px 14px;border-radius:14px;font-size:1rem;font-weight:700}
        .mobile-nav-panel nav a:hover,.mobile-nav-panel nav a:focus-visible{background:#f7e1dc;outline:none}
        .mobile-nav-panel .mobile-etsy{display:inline-flex;width:100%;margin-top:10px}

        .vip-hero{padding:44px 0 60px}
        .event-grid{grid-template-columns:minmax(0,1fr);gap:48px}
        .book{max-width:520px;width:calc(100% - 24px);margin:0 auto}
        .collab-grid{grid-template-columns:minmax(0,1fr);max-width:520px;margin:0 auto}
        .cta{flex-direction:column;align-items:flex-start;padding:40px 32px}
      }
      @media (max-width:600px){
        .book{padding:10px}
        .book-arrow{width:40px;height:40px;margin-top:-20px}
        .book-arrow.prev{left:8px}.book-arrow.next{right:8px}
        .book-thumbs button{width:58px;height:72px}
        .lb-arrow{display:none}
        .story-actions .btn{flex:1 1 100%}
        .cta{padding:36px 24px}
        .cta-actions,.cta-actions .btn{width:100%}
        .whatsapp-floating span{display:none}
        .whatsapp-floating{padding:14px}
      }
      @media (prefers-reduced-motion:reduce){
        *{transition:none !important;scroll-behavior:auto !important}
        .lightbox[open]{animation:none}
      }
    </style>
