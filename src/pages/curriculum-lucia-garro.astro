---
const seoTitle = 'Curriculum Lucia Garro | Cake Designer, Diplomi e Formazione';
const seoDescription = 'Curriculum di Lucia Garro: cake designer e pasticcera, formazione internazionale, PME Professional Diploma, Squires Kitchen e Cake International.';
const canonicalUrl = 'https://www.ledolcimeravigliedigarrolucia.com/curriculum-lucia-garro';
const etsyUrl = 'https://sweetwondersoflucy.etsy.com';
const ogImage = 'https://www.ledolcimeravigliedigarrolucia.com/images/foto-curriculum-lucia-garro.jpg';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Curriculum professionale di Lucia Garro',
  url: canonicalUrl,
  description: seoDescription,
  mainEntity: {
    '@type': 'Person',
    name: 'Lucia Garro',
    jobTitle: 'Cake Designer e Pasticcera',
    url: canonicalUrl,
    image: ogImage,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Viale Zecchino 72A',
      addressLocality: 'Siracusa',
      addressRegion: 'Sicilia',
      addressCountry: 'IT'
    },
    sameAs: [etsyUrl]
  },
  isPartOf: {
    '@type': 'WebSite',
    name: 'Le Dolci Meraviglie di Lucy Garro',
    url: 'https://www.ledolcimeravigliedigarrolucia.com/'
  }
};

const competenze = [
  'Cake design e decorazione artistica',
  'Sugarpaste e modellazione tridimensionale',
  'Royal icing e piping',
  'Wedding cake',
  'Torte scenografiche monumentali',
  'Fiori realistici in pasta di zucchero',
  'Effetti materici e texture decorative',
  'Biscotti decorati personalizzati',
  'Sweet table coordinati',
  'Progettazione estetica per eventi'
];

const formazione = [
  {
    anno: '2012',
    titolo: 'PME Professional Diploma – Sugarpaste Module',
    luogo: 'Knightsbridge PME School of Cake Decorating & Confectionery Arts · Londra',
    testo: 'Percorso professionale dedicato alla decorazione in pasta di zucchero e alle tecniche di cake design.'
  },
  {
    anno: '2016',
    titolo: 'Squires Kitchen International School',
    luogo: 'Farnham, Surrey · Regno Unito',
    testo: 'Formazione specialistica nel modulo Royal Icing Wedding Cake Papillon, con approfondimento delle tecniche di royal icing e wedding cake.'
  },
  {
    anno: '2017',
    titolo: 'Cake International – Certificate of Merit',
    luogo: 'Alexandra Palace · Londra',
    testo: 'Partecipazione alla manifestazione internazionale Cake International nella categoria Class H: Decorative Exhibit, con conseguimento del Certificate of Merit.'
  },
  {
    anno: '2018',
    titolo: 'Apertura della pasticceria Berry Cakes',
    luogo: 'Siracusa · Sicilia',
    testo: 'Apertura della pasticceria Berry Cakes a Siracusa, con Lucia Garro nel ruolo di titolare e cake designer, dedicata alla pasticceria artistica e alla realizzazione di creazioni personalizzate.'
  },
  {
    anno: '2026',
    titolo: 'Collaborazione con Pasticceria delle Meraviglie',
    luogo: 'Siracusa · Sicilia',
    testo: 'Collaborazione professionale con Pasticceria delle Meraviglie a Siracusa come cake designer, con attività di progettazione creativa e consulenze personalizzate per torte, biscotti decorati ed eventi.'
  }
];

const milestones = [
  ['Cake International', 'Partecipazione alla competizione internazionale di Londra e Certificate of Merit nella categoria Decorative Exhibit.'],
  ['PME Professional Diploma', 'Formazione professionale internazionale nel cake design e nella lavorazione della sugarpaste.'],
  ['Squires Kitchen', 'Specializzazione nelle tecniche di royal icing e wedding cake presso una scuola internazionale di cake decorating.'],
  ['Sky TG24', 'Il lavoro di Lucia Garro compare in un articolo dedicato allo show londinese delle torte artistiche.']
];

const iconeMilestone = [
  '<circle cx="12" cy="9" r="5.5"/><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"/>',
  '<path d="M2.5 9 12 5l9.5 4-9.5 4-9.5-4Z"/><path d="M6.5 11v4c3 2 8 2 11 0v-4"/>',
  '<path d="M12 3 20 6v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3Z"/><path d="m9 12 2 2 4-4"/>',
  '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h6M7 12h10M7 15h8"/>'
];
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Le Dolci Meraviglie di Lucy Garro" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Lucia Garro, cake designer e pasticcera" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <style>
      :root {
        --cream: #fffaf6;
        --ink: #3b1f18;
        --text: #4a3028;
        --muted: #7a5a50;
        --rose: #a9505e;
        --rose-soft: #f4cfd2;
        --rose-line: #c98a93;
        --gold: #d8b98a;
        --gold-dark: #c9a46b;
        --line: #eadfd5;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); background: var(--cream); line-height: 1.6; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; }
      .wrap { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }
      h1, h2, h3 { font-family: Georgia, serif; line-height: 1.12; margin-top: 0; color: var(--ink); }
      section { padding: 88px 0; }
      .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

      /* ---------- icone e decori condivisi ---------- */
      .ico{width:20px;height:20px;flex:0 0 auto;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
      .ribbon{display:block;width:120px;height:12px;fill:none;stroke:var(--rose-line);stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
      .ribbon-gold{stroke:var(--gold-dark);width:180px;height:16px}
      .eyebrow{
        position:relative;display:inline-block;margin:0 22px;padding:6px 18px;border-radius:999px;
        background:var(--rose-soft);color:#5a2a2a;font-family:Georgia,serif;font-size:.86rem;letter-spacing:.12em;text-transform:uppercase
      }
      .eyebrow::before,.eyebrow::after{content:"";position:absolute;top:50%;width:12px;height:12px;transform:translateY(-50%)}
      .eyebrow::before{left:-20px;background:
        linear-gradient(-20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 0/100% 50% no-repeat,
        linear-gradient(#c97c86,#c97c86) 0 60%/100% 1.5px no-repeat,
        linear-gradient(20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 100%/100% 50% no-repeat}
      .eyebrow::after{right:-20px;background:
        linear-gradient(20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 0/100% 50% no-repeat,
        linear-gradient(#c97c86,#c97c86) 0 60%/100% 1.5px no-repeat,
        linear-gradient(-20deg,transparent 45%,#c97c86 45% 58%,transparent 58%) 0 100%/100% 50% no-repeat}
      .swash{position:relative;display:inline-block}
      .swash svg{position:absolute;left:40%;bottom:-.18em;width:60%;height:.3em;fill:none;stroke:var(--rose-line);stroke-width:2;stroke-linecap:round}
      .section-head{max-width:720px;margin:0 auto 48px;text-align:center}
      .section-head h2{font-size:clamp(2.1rem,4vw,3.3rem);margin:16px 0 20px}
      .section-head h2 em{font-style:italic;color:var(--rose)}
      .section-head p{margin:0 auto;color:var(--text);max-width:620px}

      /* ---------- bottoni ---------- */
      .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;padding:14px 26px;font-weight:600;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}
      .btn:hover{transform:translateY(-1px)}
      .btn-primary{background:var(--rose);color:#fff;box-shadow:0 10px 24px rgba(169,80,94,.25)}
      .btn-outline{background:transparent;border:1.5px solid var(--rose);color:var(--ink)}
      .btn-outline:hover{background:#fff}
      .btn-light{background:#fff;color:var(--rose);box-shadow:0 10px 24px rgba(60,20,20,.18)}

      /* ---------- header (come in home) ---------- */
      header{position:sticky;top:0;z-index:20;background:rgba(255,250,245,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
      .nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}
      .brand{display:inline-flex;flex-direction:column;align-items:center;font-family:Georgia,serif;font-weight:700;color:var(--ink);font-size:1.4rem;line-height:1.15}
      .brand-text{white-space:nowrap}
      .brand-text span{color:var(--rose)}
      .brand-ribbon{width:min(180px,80%);height:14px;margin-top:4px;fill:none;stroke:var(--rose);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
      .nav>nav{display:flex;gap:clamp(14px,2vw,26px);font-size:.95rem}
      .nav>nav a{font-family:Georgia,serif;color:var(--ink);white-space:nowrap}
      .nav>nav a:hover,.nav>nav a[aria-current="page"]{color:var(--rose)}
      .nav>nav a[aria-current="page"]{text-decoration:underline;text-decoration-color:var(--rose-line);text-underline-offset:6px}
      .header-etsy{padding:12px 20px;white-space:nowrap}
      @media (max-width:1180px){.brand{font-size:1.15rem}.header-etsy{font-size:.9rem;padding:11px 16px}}
      @media (min-width:901px) and (max-width:1100px){.nav{gap:14px}.brand{font-size:1.02rem}.nav>nav{gap:14px}.nav>nav a{font-size:.88rem}.header-etsy{font-size:.84rem;padding:10px 14px}.header-etsy .ico{display:none}}

      .mobile-menu-toggle{
        display:none;width:46px;height:46px;flex:0 0 46px;align-items:center;justify-content:center;
        padding:0;border:1px solid var(--line);border-radius:14px;background:#fff;color:var(--ink);
        cursor:pointer;box-shadow:0 8px 22px rgba(72,48,34,.08)
      }
      .mobile-menu-toggle span,.mobile-menu-toggle span::before,.mobile-menu-toggle span::after{
        display:block;width:22px;height:2px;border-radius:2px;background:currentColor;transition:transform .2s ease,opacity .2s ease
      }
      .mobile-menu-toggle span{position:relative}
      .mobile-menu-toggle span::before,.mobile-menu-toggle span::after{content:"";position:absolute;left:0}
      .mobile-menu-toggle span::before{top:-7px}.mobile-menu-toggle span::after{top:7px}
      .mobile-menu-toggle[aria-expanded="true"] span{background:transparent}
      .mobile-menu-toggle[aria-expanded="true"] span::before{top:0;transform:rotate(45deg)}
      .mobile-menu-toggle[aria-expanded="true"] span::after{top:0;transform:rotate(-45deg)}
      .mobile-nav-panel{display:none}

      /* ---------- hero: chi è Lucia ---------- */
      .about{
        position:relative;overflow:hidden;padding:64px 0 88px;
        background:linear-gradient(100deg,#fdf6f1 0%,#fbeee8 45%,#f6dfdc 100%);
      }
      .about-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:56px;align-items:start}
      .about-copy .eyebrow{margin-left:22px}
      .about-copy h1{font-size:clamp(2.4rem,4.4vw,3.9rem);margin:22px 0 24px;letter-spacing:-.01em}
      .about-copy h1 em{font-style:italic;color:var(--rose)}
      .about-copy h1 .swash svg{left:0;width:100%}
      .about-copy p{color:var(--text);margin:0 0 16px;font-size:1.02rem;line-height:1.75}
      .about-copy p strong{color:var(--ink)}
      .about-copy .lead{font-family:Georgia,serif;font-style:italic;font-size:1.18rem;line-height:1.65;color:var(--ink)}
      .about-quote{
        position:relative;margin:24px 0;padding:22px 26px 22px 30px;border-radius:20px;
        background:rgba(255,255,255,.7);border:1px solid #f1d6d6;border-left:4px solid var(--rose);
        font-family:Georgia,serif;font-size:1.06rem;line-height:1.65;color:var(--ink)
      }
      .about-quote strong{color:var(--rose)}

      .highlights{list-style:none;padding:0;margin:30px 0 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
      .highlight{display:flex;gap:14px;align-items:flex-start;padding:18px;border-radius:18px;background:rgba(255,255,255,.85);border:2px solid #fff;box-shadow:0 10px 28px rgba(150,90,90,.1)}
      .highlight-icon{width:42px;height:42px;flex:0 0 42px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#b9606d,#a9505e);box-shadow:0 0 0 5px #fbe6e6}
      .highlight-icon svg{width:21px;height:21px;fill:none;stroke:#fff;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
      .highlight strong{display:block;font-family:Georgia,serif;font-size:1.02rem;line-height:1.3;margin-bottom:4px;color:var(--ink)}
      .highlight div span{display:block;color:var(--muted);font-size:.88rem;line-height:1.5}

      .sky-card{position:sticky;top:104px;margin:0;isolation:isolate}
      .framed{position:relative;padding:12px;border-radius:28px;background:#fff;box-shadow:0 30px 70px rgba(120,70,60,.18)}
      .framed::before{content:"";position:absolute;inset:-12px;border:1.5px solid var(--gold);border-radius:36px;z-index:-1;pointer-events:none}
      .framed img{display:block;width:100%;height:auto;border-radius:18px}
      .sky-card .framed img{max-height:620px;object-fit:contain;background:#fff}
      .sky-caption{margin-top:30px;text-align:center}
      .sky-caption .tag{display:inline-block;padding:4px 12px;border-radius:999px;background:#fff;color:var(--rose);font-family:Georgia,serif;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 4px 12px rgba(80,40,40,.08)}
      .sky-caption h2{font-size:1.5rem;margin:12px 0 4px}
      .sky-caption .ribbon{margin:6px auto 12px}
      .sky-caption p{margin:0 auto 18px;color:var(--text);font-size:.95rem;max-width:400px}

      /* ---------- specializzazione artistica ---------- */
      .expertise{background:linear-gradient(180deg,#fcf1ec 0%,#fbf3ef 100%)}
      .expertise-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
      .exp-card{
        display:flex;flex-direction:column;align-items:center;text-align:center;padding:32px 22px 28px;border-radius:24px;
        background:linear-gradient(180deg,#fff 0%,#fffaf8 100%);border:2px solid #fff;box-shadow:0 14px 34px rgba(150,90,90,.12);
        transition:transform .25s ease,box-shadow .25s ease
      }
      .exp-card:hover{transform:translateY(-6px);box-shadow:0 24px 48px rgba(150,90,90,.2)}
      .exp-icon{width:60px;height:60px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#fdf1ef,#fbe3e3);border:1.5px solid #f0cfd2}
      .exp-icon svg{width:28px;height:28px;fill:none;stroke:var(--rose);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
      .exp-card h3{margin:20px 0 4px;font-size:1.22rem}
      .exp-card .ribbon{margin:6px 0 12px}
      .exp-card p{margin:0;color:var(--text);font-size:.93rem;line-height:1.6}

      /* ---------- certificazioni internazionali ---------- */
      .certs{
        position:relative;overflow:hidden;
        background:
          radial-gradient(ellipse 60% 50% at 0% 30%,rgba(244,207,210,.45),transparent 70%),
          radial-gradient(ellipse 50% 40% at 100% 70%,rgba(234,214,186,.45),transparent 70%),
          var(--cream);
      }
      .certs::before{content:"";position:absolute;left:50%;top:36px;width:min(1160px,calc(100% - 32px));height:1px;transform:translateX(-50%);background:linear-gradient(90deg,transparent,var(--gold) 20%,var(--gold) 80%,transparent)}
      .banner{margin:0 0 80px;isolation:isolate}
      .banner.framed::before{border-radius:40px}
      .banner img{border-radius:20px}

      .cert-list{display:grid;gap:72px}
      .cert{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:64px;align-items:center}
      .cert:nth-child(even) .cert-media{order:2}
      .cert-media{position:relative;margin:0;isolation:isolate}
      .cert-media .framed img{aspect-ratio:4/3;object-fit:contain;background:linear-gradient(135deg,#fdf3ef,#f8e6e3)}
      .cert-year{
        position:absolute;top:-20px;right:-10px;z-index:2;width:84px;height:84px;display:grid;place-items:center;border-radius:50%;
        background:linear-gradient(135deg,#b9606d,#a9505e);color:#fff;font-family:Georgia,serif;font-size:1.3rem;font-weight:700;
        box-shadow:0 0 0 6px #fbe6e6,0 14px 30px rgba(169,80,94,.35)
      }
      .cert:nth-child(even) .cert-year{right:auto;left:-10px}
      .cert-tag{display:inline-block;padding:5px 14px;border-radius:999px;background:var(--rose-soft);color:#5a2a2a;font-family:Georgia,serif;font-size:.78rem;letter-spacing:.1em;text-transform:uppercase}
      .cert-body h3{font-size:clamp(1.7rem,3vw,2.3rem);margin:16px 0 6px}
      .cert-body .ribbon{margin:6px 0 18px}
      .cert-body p{margin:0 0 14px;color:var(--text);line-height:1.75}
      .cert-body p strong{color:var(--ink)}
      .cert-facts{list-style:none;padding:0;margin:20px 0 0;display:flex;flex-wrap:wrap;gap:10px}
      .cert-facts li{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:#fff;border:1px solid #f0d8d8;font-size:.86rem;color:var(--ink)}
      .cert-facts .ico{width:16px;height:16px;color:var(--rose)}

      /* ---------- social ---------- */
      .social{background:linear-gradient(180deg,#fbf3ef 0%,#fcf1ec 100%)}
      .social-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:center}
      .social-intro .eyebrow{margin-left:22px}
      .social-intro h2{font-size:clamp(2rem,3.6vw,3rem);margin:16px 0 20px}
      .social-intro h2 em{font-style:italic;color:var(--rose)}
      .social-intro p{color:var(--text);margin:0 0 14px}
      .social-card{
        display:flex;gap:22px;align-items:center;padding:28px;border-radius:24px;background:#fff;border:2px solid #fff;
        box-shadow:0 14px 34px rgba(150,90,90,.14);transition:transform .25s ease,box-shadow .25s ease
      }
      .social-card:hover{transform:translateY(-5px);box-shadow:0 24px 48px rgba(150,90,90,.22)}
      .yt-icon{width:76px;height:76px;flex:0 0 76px;display:grid;place-items:center;border-radius:22px;background:linear-gradient(135deg,#e0525f,#b8323f);box-shadow:0 12px 24px rgba(184,50,63,.3)}
      .yt-icon svg{width:34px;height:34px;fill:#fff}
      .social-label{font-family:Georgia,serif;font-size:.78rem;letter-spacing:.14em;color:var(--rose);text-transform:uppercase}
      .social-card h3{font-size:1.5rem;margin:4px 0 6px}
      .social-card p{margin:0 0 10px;color:var(--text);font-size:.94rem}
      .social-link{display:inline-flex;align-items:center;gap:6px;font-weight:600;color:var(--rose);font-size:.92rem}
      .social-link .ico{width:16px;height:16px;transition:transform .2s ease}
      .social-card:hover .social-link .ico{transform:translateX(3px)}

      /* ---------- CTA finale ---------- */
      .final{padding:88px 0}
      .cta{
        position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:28px;
        padding:52px 56px;border-radius:32px;color:#fff;
        background:radial-gradient(ellipse 60% 120% at 100% 0%,rgba(255,255,255,.18),transparent 60%),linear-gradient(120deg,#b9606d 0%,#a9505e 55%,#93404e 100%);
        box-shadow:0 26px 60px rgba(169,80,94,.3)
      }
      .cta::before{content:"";position:absolute;inset:12px;border:1px solid rgba(255,255,255,.35);border-radius:24px;pointer-events:none}
      .cta h2{color:#fff;margin:0 0 8px;font-size:clamp(1.9rem,3.6vw,2.9rem)}
      .cta p{margin:0;opacity:.92;max-width:560px}
      .cta .ribbon{stroke:rgba(255,255,255,.7);margin:0 0 14px}
      .cta-actions{display:flex;flex-wrap:wrap;gap:12px;position:relative}
      .cta .btn-ghost{border:1.5px solid rgba(255,255,255,.7);color:#fff}
      .cta .btn-ghost:hover{background:rgba(255,255,255,.12)}

      footer{padding:36px 0 56px;color:var(--muted);font-size:.9rem;border-top:1px solid var(--line)}

      /* ---------- responsive ---------- */
      @media (max-width:1000px){
        .expertise-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      }
      @media (max-width:900px){
        section{padding:68px 0}
        .nav{min-height:76px;gap:14px}
        .nav>nav,.nav>.btn-primary{display:none}
        .brand{align-items:flex-start;font-size:clamp(.95rem,4.2vw,1.25rem);min-width:0}
        .brand-text{white-space:normal}
        .brand-ribbon{display:none}
        .mobile-menu-toggle{display:inline-flex;margin-left:auto}
        .mobile-nav-panel{
          display:block;position:absolute;top:calc(100% + 8px);left:16px;right:16px;padding:12px;
          border:1px solid var(--line);border-radius:22px;background:rgba(255,250,245,.99);
          box-shadow:0 22px 54px rgba(72,48,34,.18);transform:translateY(-8px);opacity:0;
          visibility:hidden;pointer-events:none;transition:opacity .2s ease,transform .2s ease,visibility .2s ease
        }
        .mobile-nav-panel.is-open{transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
        .mobile-nav-panel nav{display:grid;gap:4px}
        .mobile-nav-panel nav a{display:block;padding:13px 14px;border-radius:14px;font-size:1rem;font-weight:700}
        .mobile-nav-panel nav a:hover,.mobile-nav-panel nav a:focus-visible{background:#f7e1dc;outline:none}
        .mobile-nav-panel .mobile-etsy{display:inline-flex;width:100%;margin-top:10px}

        .about{padding:40px 0 64px}
        .about-grid,.social-grid{grid-template-columns:1fr;gap:48px}
        .sky-card{position:static;max-width:520px;margin:0 auto;width:calc(100% - 28px)}
        .cert{grid-template-columns:1fr;gap:36px}
        .cert:nth-child(even) .cert-media{order:0}
        .cert-media{width:calc(100% - 28px);margin:0 auto}
        .cert:nth-child(even) .cert-year{left:auto;right:-10px}
        .banner{width:calc(100% - 28px);margin:0 auto 64px}
        .cta{flex-direction:column;align-items:flex-start;padding:40px 32px}
      }
      @media (max-width:600px){
        .highlights,.expertise-grid{grid-template-columns:1fr}
        .cert-year{width:68px;height:68px;font-size:1.1rem}
        .social-card{flex-direction:column;align-items:flex-start}
        .cta{padding:36px 24px}
        .cta-actions,.cta-actions .btn{width:100%}
      }
      @media (prefers-reduced-motion:reduce){*{transition:none !important}}

      /* ===== Curriculum: stili specifici ===== */
      .about-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}
      .profile{position:sticky;top:104px;margin:0;isolation:isolate}
      .profile .framed{padding:34px 28px 28px;text-align:center}
      .profile-photo{width:min(280px,100%);height:auto;aspect-ratio:1;margin:0 auto;border-radius:50%;padding:7px;background:linear-gradient(135deg,#d8b98a,#f4cfd2,#d8b98a);box-shadow:0 14px 30px rgba(169,80,94,.25)}
      .profile-photo img{width:100%;height:100%;object-fit:cover;border-radius:50% !important;border:4px solid #fff}
      .profile .tag{display:inline-block;margin-top:18px;padding:4px 12px;border-radius:999px;background:var(--rose-soft);color:#5a2a2a;font-family:Georgia,serif;font-size:.76rem;letter-spacing:.1em;text-transform:uppercase}
      .profile-name{margin:10px 0 2px;font-family:Georgia,serif;font-size:1.9rem;font-weight:700;color:var(--ink)}
      .profile-role{font-family:Georgia,serif;font-style:italic;color:var(--rose);font-size:1rem}
      .profile .ribbon{margin:12px auto 18px}
      .profile-facts{list-style:none;padding:0;margin:0;display:grid;gap:10px;text-align:left}
      .profile-fact{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border-radius:14px;background:linear-gradient(135deg,#fdf6f3,#fbeeec);border:1px solid #f3dede}
      .profile-fact .ico{width:20px;height:20px;margin-top:2px;color:var(--rose)}
      .profile-fact strong{display:block;font-family:Georgia,serif;font-size:.95rem;color:var(--ink)}
      .profile-fact span{display:block;font-size:.86rem;color:var(--muted);line-height:1.45}

      .summary-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:56px;align-items:start}
      .summary-title .eyebrow{margin-left:22px}
      .summary-title h2{font-size:clamp(2rem,3.4vw,2.9rem);margin:16px 0 0}
      .summary-title h2 em{font-style:italic;color:var(--rose)}
      .summary-title .ribbon{margin-top:18px}
      .summary-copy p{color:var(--text);margin:0 0 16px;line-height:1.75}
      .summary-copy .about-quote{margin-top:0}
      .milestones{list-style:none;padding:0;margin:48px 0 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}

      .timeline{position:relative;list-style:none;padding:0;margin:0 auto;max-width:1000px}
      .timeline::before{content:"";position:absolute;top:10px;bottom:10px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(180deg,transparent,var(--gold) 6%,var(--gold) 94%,transparent)}
      .tl-item{position:relative;display:grid;grid-template-columns:1fr 96px 1fr;align-items:center}
      .tl-item + .tl-item{margin-top:26px}
      .tl-year{
        grid-column:2;justify-self:center;z-index:1;width:84px;height:84px;display:grid;place-items:center;border-radius:50%;
        background:linear-gradient(135deg,#b9606d,#a9505e);color:#fff;font-family:Georgia,serif;font-size:1.2rem;font-weight:700;
        box-shadow:0 0 0 6px #fbe6e6,0 12px 26px rgba(169,80,94,.3)
      }
      .tl-card{
        grid-row:1;padding:24px 26px;border-radius:22px;background:linear-gradient(180deg,#fff,#fffaf8);border:2px solid #fff;
        box-shadow:0 14px 34px rgba(150,90,90,.12);transition:transform .25s ease,box-shadow .25s ease
      }
      .tl-card:hover{transform:translateY(-4px);box-shadow:0 22px 44px rgba(150,90,90,.2)}
      .tl-item:nth-child(odd) .tl-card{grid-column:1;text-align:right}
      .tl-item:nth-child(even) .tl-card{grid-column:3}
      .tl-item .tl-year{grid-row:1}
      .tl-card h3{font-size:1.25rem;margin:0 0 6px}
      .tl-place{display:inline-flex;align-items:center;gap:6px;font-size:.86rem;color:var(--rose);font-weight:600;margin-bottom:8px}
      .tl-place .ico{width:15px;height:15px}
      .tl-place{display:flex;align-items:flex-start;text-align:inherit}
      .tl-place .ico{margin-top:3px}
      .tl-item:nth-child(odd) .tl-place{flex-direction:row-reverse}
      .tl-card p{margin:0;color:var(--text);font-size:.94rem;line-height:1.65}

      .skills{list-style:none;padding:0;margin:0 auto;max-width:980px;display:flex;flex-wrap:wrap;justify-content:center;gap:12px}
      .skill{display:inline-flex;align-items:center;gap:10px;padding:12px 20px;border-radius:999px;background:#fff;border:1.5px solid #f0d6d8;
        font-family:Georgia,serif;color:var(--ink);font-size:1rem;box-shadow:0 8px 20px rgba(150,90,90,.08);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
      .skill:hover{transform:translateY(-3px);border-color:var(--rose-line);box-shadow:0 14px 28px rgba(150,90,90,.16)}
      .skill .ico{width:17px;height:17px;color:var(--rose)}

      .press-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:64px;align-items:center}
      .press-media{margin:0;isolation:isolate}
      .press-media .framed img{max-height:560px;object-fit:contain;background:#fff}
      .press-copy .eyebrow{margin-left:22px}
      .press-copy h2{font-size:clamp(1.9rem,3.2vw,2.7rem);margin:16px 0 6px}
      .press-copy h2 em{font-style:italic;color:var(--rose)}
      .press-copy .ribbon{margin:10px 0 20px}
      .press-copy p{color:var(--text);margin:0 0 16px;line-height:1.75}
      .press-copy .btn{margin-top:10px}

      .cert-links{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
      .cert-link{
        display:flex;flex-direction:column;align-items:center;text-align:center;height:100%;padding:34px 24px 28px;border-radius:24px;
        background:linear-gradient(135deg,#fdf1ef 0%,#fbe6e6 100%);border:2px solid #fff;box-shadow:0 14px 34px rgba(150,90,90,.12);
        transition:transform .25s ease,box-shadow .25s ease
      }
      .cert-link:hover{transform:translateY(-6px);box-shadow:0 24px 48px rgba(150,90,90,.22)}
      .cert-link .highlight-icon{width:58px;height:58px;flex-basis:58px}
      .cert-link .highlight-icon svg{width:26px;height:26px}
      .cert-link .cert-tag{margin-top:20px;background:#fff}
      .cert-link h3{margin:14px 0 4px;font-size:1.3rem}
      .cert-link .ribbon{margin:6px 0 14px}
      .cert-link .social-link{margin-top:auto}
      .cert-link:hover .social-link .ico{transform:translateX(3px)}

      .whatsapp-floating{
        position:fixed;right:20px;bottom:20px;z-index:30;display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:999px;
        background:#25d366;color:#fff;font-weight:700;font-size:.92rem;box-shadow:0 12px 28px rgba(37,211,102,.35);transition:transform .2s ease
      }
      .whatsapp-floating:hover{transform:translateY(-2px)}
      .whatsapp-floating svg{width:20px;height:20px;fill:#fff}

      @media (max-width:1000px){.milestones{grid-template-columns:repeat(2,minmax(0,1fr))}}
      @media (max-width:900px){
        .profile{position:static;max-width:480px;margin:0 auto;width:calc(100% - 28px)}
        .summary-grid,.press-grid{grid-template-columns:1fr;gap:36px}
        .press-media{width:calc(100% - 28px);margin:0 auto}
        .timeline::before{left:42px;transform:none}
        .tl-item{grid-template-columns:84px 1fr;gap:18px;align-items:start}
        .tl-item .tl-year{grid-column:1}
        .tl-item:nth-child(odd) .tl-card,.tl-item:nth-child(even) .tl-card{grid-column:2;text-align:left}
        .tl-item:nth-child(odd) .tl-place{flex-direction:row}
        .cert-links{grid-template-columns:1fr}
      }
      @media (max-width:600px){
        .profile-photo{width:min(240px,100%)}
        .milestones{grid-template-columns:1fr}
        .about-actions .btn{flex:1 1 100%}
        .tl-item{grid-template-columns:64px 1fr;gap:14px}
        .tl-year{width:64px;height:64px;font-size:1rem}
        .timeline::before{left:31px}
        .skill{font-size:.92rem;padding:10px 16px}
        .whatsapp-floating span{display:none}
        .whatsapp-floating{padding:14px}
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap nav">
