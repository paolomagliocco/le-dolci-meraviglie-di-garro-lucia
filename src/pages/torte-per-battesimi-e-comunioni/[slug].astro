      .reviews-empty{margin:18px 0 0;padding:16px;border-radius:16px;background:#fdf3f1;color:var(--text);font-size:.92rem}

      .review-list{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:14px}
      .review{padding:22px 24px;border-radius:22px;background:#fff;border:1px solid #f1e1dc}
      .review-head{display:flex;align-items:center;gap:12px;margin-bottom:10px}
      .avatar{width:42px;height:42px;flex:0 0 42px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#b9606d,#a9505e);color:#fff;font:600 .9rem/1 Inter,system-ui,sans-serif}
      .review-head strong{display:block;font-family:Georgia,serif;color:var(--ink)}
      .review-head time{font-size:.8rem;color:var(--muted)}
      .review-head .stars{margin-left:auto;font-size:1rem}
      .review p{margin:0;color:var(--text);line-height:1.7}

      .review-form{padding:34px 36px;border-radius:28px;background:#fff;border:2px solid #fff;box-shadow:0 10px 28px rgba(150,90,90,.1)}
      .review-form h3{font-size:1.6rem;margin:0 0 6px}
      .review-form>p{margin:0 0 22px;color:var(--text);font-size:.94rem}
      .star-input{margin:0 0 20px;padding:0;border:0}
      .star-input legend{margin-bottom:8px;font-weight:600;font-size:.92rem;color:var(--ink)}
      .star-input-row{display:inline-flex;flex-direction:row-reverse;gap:4px}
      .star-input input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
      .star-input label{font-size:2.2rem;line-height:1;color:#e8d3c4;cursor:pointer;transition:color .15s ease,transform .15s ease}
      .star-input label:hover,.star-input label:hover~label,.star-input input:checked~label{color:var(--gold-dark)}
      .star-input label:hover{transform:scale(1.12)}
      .star-input input:focus-visible+label{outline:2px solid var(--rose);outline-offset:2px;border-radius:6px}
      .star-hint{display:block;min-height:1.3em;margin-top:6px;font-size:.86rem;color:var(--rose);font-weight:600}
      .field{display:grid;gap:6px;margin-bottom:16px;font-weight:600;font-size:.92rem;color:var(--ink)}
      .field input,.field textarea{
        width:100%;padding:13px 16px;border:1.5px solid #ecd9d2;border-radius:14px;background:#fffaf6;color:var(--ink);
        font:400 .98rem/1.5 Inter,system-ui,sans-serif;transition:border-color .2s ease,box-shadow .2s ease
      }
      .field textarea{min-height:130px;resize:vertical}
      .field input:focus,.field textarea:focus{outline:none;border-color:var(--rose);box-shadow:0 0 0 4px rgba(169,80,94,.12)}
      .field small{font-weight:400;color:var(--muted);font-size:.8rem;text-align:right}
      .check{display:flex;gap:10px;align-items:flex-start;margin:4px 0 20px;font-size:.86rem;line-height:1.5;color:var(--text)}
      .check input{margin-top:3px;accent-color:var(--rose)}
      .review-form .btn{width:100%;padding:15px 20px;border:0;font-size:.98rem;cursor:pointer}
      .form-note{margin:12px 0 0;color:var(--muted);font-size:.82rem;text-align:center}
      .form-status{margin:12px 0 0;min-height:1.2em;font-size:.9rem;font-weight:600;text-align:center;color:var(--rose)}

      /* ---------- altre torte e navigazione ---------- */
      .related{padding-top:24px}
      .product-pager{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin-top:44px}
      .pager-link{display:flex;flex-direction:column;gap:2px;padding:16px 20px;border-radius:18px;background:#fff;border:1px solid #f1e1dc;transition:border-color .2s ease,transform .2s ease}
      .pager-link:hover{border-color:var(--rose-line);transform:translateY(-2px)}
      .pager-link small{font-size:.76rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
      .pager-link strong{font-family:Georgia,serif;color:var(--ink)}
      .pager-next{text-align:right}

      /* ---------- lightbox ---------- */
      .lightbox{width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;border:0;background:rgba(28,12,10,.94);color:#fff}
      .lightbox[open]{display:grid;place-items:center}
      .lightbox::backdrop{background:rgba(28,12,10,.94)}
      .lightbox img{max-width:min(92vw,1100px);max-height:86dvh;object-fit:contain;border-radius:14px;box-shadow:0 30px 80px rgba(0,0,0,.5)}
      .lb-close{position:absolute;top:18px;right:18px;display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border:0;border-radius:999px;background:rgba(255,255,255,.95);color:var(--ink);font:600 .9rem/1 Inter,system-ui,sans-serif;cursor:pointer}
      .lb-close svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round}
      .lightbox .pg-btn{position:fixed}
      .lb-caption{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);padding:6px 16px;border-radius:999px;background:rgba(255,255,255,.14);font-size:.86rem;white-space:nowrap}

      /* ---------- barra acquisto mobile ---------- */
      .buybar{display:none}

      @media (max-width:900px){
        .product-hero{padding:28px 0 64px}
        .product-layout{grid-template-columns:1fr;gap:32px}
        .pg{position:static}
        .info-grid,.reviews-grid{grid-template-columns:1fr}
        .info-card{padding:30px 26px}
        .buybar{
          position:fixed;left:0;right:0;bottom:0;z-index:35;display:flex;align-items:center;gap:12px;padding:12px 16px calc(12px + env(safe-area-inset-bottom));
          background:rgba(255,250,245,.97);backdrop-filter:blur(10px);border-top:1px solid var(--line);box-shadow:0 -10px 30px rgba(72,48,34,.12);
          transform:translateY(110%);transition:transform .3s ease
        }
        .buybar.is-visible{transform:none}
        .buybar div{flex:1 1 auto;min-width:0}
        .buybar strong{display:block;font-family:Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .buybar small{color:var(--rose);font-weight:600}
        .buybar .btn{flex:0 0 auto;padding:12px 18px;font-size:.9rem}
        body:has(.buybar.is-visible) .whatsapp-floating{bottom:84px}
      }
      @media (max-width:600px){
        .buy-actions{grid-template-columns:1fr}
        .spec-grid{grid-template-columns:1fr}
        .trust{grid-template-columns:1fr;text-align:left}
        .trust li{flex-direction:row;text-align:left}
        .pg-btn{width:42px;height:42px}
        .pg-zoom span{display:none}
        .pg-thumb{padding:6px;justify-content:center}
        .pg-thumb span{display:none}
        .review-form{padding:28px 22px}
        .product-pager{grid-template-columns:1fr 1fr}
        .product-pager .pager-all{grid-column:1 / -1;grid-row:2;justify-self:center}
      }
      @media (prefers-reduced-motion:reduce){.pg-track{transition:none}}
    </style>
  </head>
  <body>
    <header>
      <div class="wrap nav">
        <a class="brand" href="/"><span class="brand-text">Le Dolci Meraviglie<span> di Lucy Garro</span></span><svg class="brand-ribbon" viewBox="0 0 180 16" aria-hidden="true"><path d="M4 8h66M110 8h66"/><path d="M90 8c-6-7-16-7-16 0s10 7 16 0Zm0 0c6-7 16-7 16 0s-10 7-16 0Zm0 0-6 7m6-7 6 7"/></svg></a>

        <nav aria-label="Navigazione principale">
          <a href="/biscotti-decorati">Biscotti</a>
          <div class="nav-dropdown">
            <a href="/torte-artistiche" class="is-current-section">Torte artistiche</a>
            <div class="nav-submenu">
              <a href="/torte-di-laurea">Torte di Laurea</a>
              <a href="/torte-di-compleanno-per-adulti">Torte di Compleanno per Adulti</a>
              <a href="/torte-per-battesimi-e-comunioni" aria-current="true">Torte per Battesimi e Comunioni</a>
            </div>
          </div>
          <a href="/sweet-table">Sweet Table</a>
          <a href="/vip-e-collaborazioni">VIP e collab.</a>
          <a href="/curriculum-lucia-garro">Curriculum</a>
          <a href="/certificazioni">Certificazioni</a>
          <a href="/contatti">Contatti</a>
        </nav>

        <a class="btn btn-primary header-etsy" href={etsyUrl} title="Vai su Etsy" target="_blank" rel="noopener"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>Vai su Etsy per acquistare online</a>

        <button
          class="mobile-menu-toggle"
          type="button"
          aria-label="Apri menu di navigazione"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          data-mobile-menu-toggle
        >
          <span aria-hidden="true"></span>
        </button>

        <div class="mobile-nav-panel" id="mobile-nav-panel" data-mobile-nav>
          <nav aria-label="Navigazione mobile">
            <a href="/biscotti-decorati">Biscotti</a>
            <a href="/torte-artistiche">Torte artistiche</a>
            <a class="mobile-sub" href="/torte-di-laurea">Torte di Laurea</a>
            <a class="mobile-sub" href="/torte-di-compleanno-per-adulti">Torte di Compleanno per Adulti</a>
            <a class="mobile-sub" href="/torte-per-battesimi-e-comunioni" aria-current="true">Torte per Battesimi e Comunioni</a>
            <a href="/sweet-table">Sweet Table</a>
            <a href="/vip-e-collaborazioni">VIP e collab.</a>
            <a href="/curriculum-lucia-garro">Curriculum</a>
            <a href="/certificazioni">Certificazioni</a>
            <a href="/contatti">Contatti</a>
          </nav>
          <a class="btn btn-primary mobile-etsy" href={etsyUrl} target="_blank" rel="noopener">
            Vai su Etsy per acquistare online
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="product-hero">
        <div class="wrap">
          <nav class="breadcrumb" aria-label="Percorso">
            <a href="/">Home</a><span aria-hidden="true">›</span><a href="/torte-artistiche">Torte artistiche</a><span aria-hidden="true">›</span><a href="/torte-per-battesimi-e-comunioni">Torte per battesimi e comunioni</a><span aria-hidden="true">›</span><span aria-current="page">{nome}</span>
          </nav>

          <div class="product-layout">
            <!-- carousel foto -->
            <div class="pg" data-carousel>
              <div class="pg-stage" tabindex="0" role="region" aria-roledescription="carosello" aria-label={`Foto della ${nome}`} data-stage>
                <div class="pg-track" data-track>
                  {torta.foto.map((foto, i) => (
                    <figure class="pg-slide" role="group" aria-roledescription="foto" aria-label={`${i + 1} di ${torta.foto.length}: ${foto.label}`} data-label={foto.label}>
                      <div class="pg-slide-bg" style={`background-image:url('${foto.src}')`} aria-hidden="true"></div>
                      <img
                        src={foto.src}
                        alt={`${nome} – ${foto.label.toLowerCase()}, realizzata da Lucia Garro`}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                        decoding="async"
                        data-zoom-img
                      />
                    </figure>
                  ))}
                </div>
                <span class="pg-label" data-pg-label>{torta.foto[0].label}</span>
                <span class="pg-counter" aria-hidden="true"><span data-pg-current>1</span> / {torta.foto.length}</span>
                {torta.foto.length > 1 && (
                  <>
                    <button type="button" class="pg-btn pg-prev" aria-label="Foto precedente" data-prev><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
                    <button type="button" class="pg-btn pg-next" aria-label="Foto successiva" data-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
                  </>
                )}
                <button type="button" class="pg-zoom" data-zoom><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M11 8v6M8 11h6"/></svg><span>Ingrandisci</span></button>
              </div>
              {torta.foto.length > 1 && (
                <div class="pg-thumbs" role="group" aria-label="Scegli la foto">
                  {torta.foto.map((foto, i) => (
                    <button type="button" class="pg-thumb" aria-current={i === 0 ? 'true' : 'false'} data-thumb={i}>
                      <img src={foto.src} alt="" loading="lazy" decoding="async" />
                      <span>{foto.label}</span>
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- informazioni prodotto -->
            <div class="product-info">
              <span class="product-pill">{tipoTorta(torta)}</span>
              <h1>{nome}</h1>
              <div class="rating-line">
                <span class="stars" style={`--voto:${media}`} aria-hidden="true">★★★★★</span>
                {totale > 0
                  ? <a href="#recensioni">{media.toLocaleString('it-IT')} su 5 · {totale} {totale === 1 ? 'recensione' : 'recensioni'}</a>
                  : <span>Nessuna recensione · <a href="#scrivi-recensione">scrivi la prima</a></span>}
              </div>
              <p class="product-course-line">Tema: <strong>{torta.tema}</strong></p>
              <p class="product-lead">{torta.descrizione}</p>

              <div class="price-box">
                <span>Prezzo</span>
                <strong>Su richiesta</strong>
                <small>Preventivo gratuito e senza impegno, in base a dimensioni, numero di piani e personalizzazioni.</small>
              </div>

              <ul class="product-highlights">
                {torta.dettagli.map((d) => <li>{d}</li>)}
              </ul>

              <dl class="spec-grid">
                <div><dt>Forma</dt><dd>{torta.forma}</dd></div>
                <div><dt>Versione</dt><dd>Vera o scenografica</dd></div>
                <div><dt>Tema</dt><dd>{torta.tema}</dd></div>
                <div><dt>Personalizzazione</dt><dd>Nome, data, dedica e colori</dd></div>
              </dl>

              <div class="buy-actions">
                <a class="btn btn-primary" href="/contatti"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 3 10 14"/><path d="m21 3-7 18-4-7-7-4 18-7Z"/></svg>Richiedi preventivo</a>
                <a class="btn btn-wa" href={waLink} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.7-1.2 2.2 2.2 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3Z"/></svg>Ordina su WhatsApp</a>
              </div>
              <div class="share-row">
                <button type="button" class="share-btn" data-share data-title={`${nome}`}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>Condividi questa torta</button>
                <span class="share-status" role="status" aria-live="polite" data-share-status></span>
              </div>

              <ul class="trust">
                <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z"/></svg>Fatta a mano a Siracusa</li>
                <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m14 4 6 6-9 9H5v-6l9-9Z"/><path d="m12 6 6 6"/></svg>Progetto su misura per la tua festa</li>
                <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="m8.5 14-1.5 7 5-3 5 3-1.5-7"/></svg><span>Cake designer <a href="/certificazioni">certificata</a></span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="details" aria-labelledby="descrizione-title">
        <div class="wrap info-grid">
          <article class="info-card">
            <h2 id="descrizione-title">La <em>torta</em></h2>
            <svg class="ribbon" viewBox="0 0 120 12" aria-hidden="true"><path d="M2 6h46M72 6h46"/><path d="M60 6c-4-5-11-5-11 0s7 5 11 0Zm0 0c4-5 11-5 11 0s-7 5-11 0Zm0 0-4 5m4-5 4 5"/></svg>
            {torta.descrizioneLunga.map((paragrafo) => <p set:html={paragrafo} />)}
          </article>
          <aside class="info-card tinted" aria-labelledby="personalizza-title">
            <h2 id="personalizza-title">Cosa puoi <em>personalizzare</em></h2>
            <svg class="ribbon" viewBox="0 0 120 12" aria-hidden="true"><path d="M2 6h46M72 6h46"/><path d="M60 6c-4-5-11-5-11 0s7 5 11 0Zm0 0c4-5 11-5 11 0s-7 5-11 0Zm0 0-4 5m4-5 4 5"/></svg>
            <ul class="custom-list">
              {personalizzazioni.map((p) => <li>{p}</li>)}
            </ul>
          </aside>
        </div>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Domande frequenti</span>
            <h2 id="faq-title">Prima di <em>ordinare</em></h2>
          </div>
          <div class="faq-list">
            {faq.map((item, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>{item.d}</summary>
                <p>{item.r}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="reviews" id="recensioni" aria-labelledby="recensioni-title">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Recensioni</span>
            <h2 id="recensioni-title">Cosa dicono della <em>{nomeInFrase}</em></h2>
            <p>Hai festeggiato un battesimo o una comunione con questa torta? Racconta la tua esperienza e aiuta altre famiglie a scegliere.</p>
          </div>

          <div class="reviews-grid">
            <div>
              <div class="reviews-summary">
                <div class="reviews-avg">{totale ? media.toLocaleString('it-IT', { minimumFractionDigits: 1 }) : '–'}</div>
                <span class="stars" style={`--voto:${media}`} aria-hidden="true">★★★★★</span>
                <p class="reviews-count">{totale ? `Media di ${totale} ${totale === 1 ? 'recensione' : 'recensioni'}` : 'Ancora nessuna recensione'}</p>
                <ul class="dist" aria-label="Distribuzione dei voti">
                  {distribuzione.map((riga) => (
                    <li>
                      <span>{riga.voto} ★</span>
                      <span class="dist-bar" aria-hidden="true"><span style={`width:${riga.perc}%`}></span></span>
                      <span>{riga.n}</span>
                    </li>
                  ))}
                </ul>
                {totale === 0 && <p class="reviews-empty">Sii il primo a lasciare una recensione per questa torta!</p>}
              </div>

              {totale > 0 && (
                <ul class="review-list">
                  {recensioni.map((r) => (
                    <li class="review">
                      <div class="review-head">
                        <span class="avatar" aria-hidden="true">{iniziali(r.nome)}</span>
                        <div><strong>{r.nome}</strong><time datetime={r.data}>{formatData(r.data)}</time></div>
                        <span class="stars" style={`--voto:${r.voto}`} role="img" aria-label={`${r.voto} stelle su 5`}>★★★★★</span>
                      </div>
                      <p>{r.testo}</p>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <form class="review-form" id="scrivi-recensione" data-review-form data-torta={nome} novalidate>
              <h3>Scrivi una recensione</h3>
              <p>Dai un voto da 1 a 5 stelle e raccontaci com’è andata la festa.</p>

              <fieldset class="star-input">
                <legend>Il tuo voto</legend>
                <div class="star-input-row">
                  {[5, 4, 3, 2, 1].map((v) => (
                    <>
                      <input type="radio" name="voto" id={`voto-${v}`} value={v} required />
                      <label for={`voto-${v}`} title={`${v} ${v === 1 ? 'stella' : 'stelle'}`}><span aria-hidden="true">★</span><span class="sr-only">{v} {v === 1 ? 'stella' : 'stelle'}</span></label>
                    </>
                  ))}
                </div>
                <span class="star-hint" data-star-hint aria-live="polite"></span>
              </fieldset>

              <label class="field">Nome
                <input type="text" name="nome" maxlength="60" autocomplete="name" placeholder="Es. Giulia R." required />
              </label>
              <label class="field">La tua recensione
                <textarea name="testo" maxlength="800" placeholder="Com’era la torta? Ti è piaciuta? Cosa hanno detto gli ospiti?" required data-testo></textarea>
                <small><span data-chars>0</span> / 800</small>
              </label>
              <label class="check">
                <input type="checkbox" name="consenso" required />
                <span>Acconsento alla pubblicazione della recensione con il mio nome sul sito.</span>
              </label>

              <button type="submit" class="btn btn-primary">Invia la recensione</button>
              <p class="form-note">La recensione viene inviata a Lucia tramite WhatsApp e pubblicata dopo la verifica.</p>
              <p class="form-status" role="status" aria-live="polite" data-form-status></p>
            </form>
          </div>
        </div>
      </section>

      <section class="cakes related" aria-labelledby="correlate-title">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Potrebbero piacerti</span>
            <h2 id="correlate-title">Altre torte per battesimi <em>e comunioni</em></h2>
          </div>

          <div class="cake-grid">
            {correlate.map((altra) => (
              <article class="cake-card product-card" data-cake-card data-href={urlProdotto(altra)}>
                <div class="cake-gallery" data-cake-gallery>
                  <span class="category">{altra.categoria}</span>
                  <span class="zoom-cue" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg><span>Vedi la torta</span></span>
                  {altra.foto.length > 1 && (
                    <span class="photo-label" aria-hidden="true">
                      <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="14" rx="3"/><circle cx="12" cy="13" r="3.5"/><path d="M8 6l1.5-2h5L16 6"/></svg>
                      <span data-photo-label>{altra.foto[0].label}</span>
                    </span>
                  )}
                  {altra.foto.map((foto, i) => (
                    <img
                      src={foto.src}
                      alt={`${nomeCompleto(altra)} – ${foto.label.toLowerCase()}`}
                      class:list={[{ 'is-active': i === 0 }]}
                      data-label={foto.label}
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                  {altra.foto.length > 1 && (
                    <>
                      <div class="gallery-dots" role="group" aria-label={`Foto di ${nomeCompleto(altra)}`}>
                        {altra.foto.map((foto, i) => (
                          <button type="button" aria-label={`Mostra foto: ${foto.label}`} aria-pressed={i === 0 ? 'true' : 'false'} data-index={i}></button>
                        ))}
                      </div>
                      <span class="gallery-progress" aria-hidden="true"></span>
                    </>
                  )}
                </div>
                <div class="cake-body">
                  <span class="product-course">Tema: {altra.tema}</span>
                  <h3><a class="card-open" href={urlProdotto(altra)}>{nomeCompleto(altra)}</a></h3>
                  <svg class="ribbon" viewBox="0 0 120 12" aria-hidden="true"><path d="M2 6h46M72 6h46"/><path d="M60 6c-4-5-11-5-11 0s7 5 11 0Zm0 0c4-5 11-5 11 0s-7 5-11 0Zm0 0-4 5m4-5 4 5"/></svg>
                  <p>{altra.descrizione}</p>
                  <div class="product-price"><span>Prezzo</span><strong>Su richiesta</strong></div>
                  <div class="cake-actions">
                    <a class="btn btn-primary" href={urlProdotto(altra)}>Scopri la torta<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <nav class="product-pager" aria-label="Altre torte per battesimi e comunioni">
            <a class="pager-link pager-prev" href={urlProdotto(precedente)} rel="prev"><small>‹ Precedente</small><strong>{nomeCompleto(precedente)}</strong></a>
            <a class="btn btn-outline pager-all" href="/torte-per-battesimi-e-comunioni#catalogo">Tutte le torte per battesimi e comunioni</a>
            <a class="pager-link pager-next" href={urlProdotto(successiva)} rel="next"><small>Successiva ›</small><strong>{nomeCompleto(successiva)}</strong></a>
          </nav>
        </div>
      </section>

      <section class="final">
        <div class="wrap">
          <div class="cta">
            <div>
              <svg class="ribbon" viewBox="0 0 120 12" aria-hidden="true"><path d="M2 6h46M72 6h46"/><path d="M60 6c-4-5-11-5-11 0s7 5 11 0Zm0 0c4-5 11-5 11 0s-7 5-11 0Zm0 0-4 5m4-5 4 5"/></svg>
              <h2>Ti piace la {nomeInFrase}?</h2>
              <p>Raccontami cerimonia, nome, data, numero di invitati e colori della festa: la personalizziamo insieme per il vostro giorno speciale.</p>
            </div>
            <div class="cta-actions">
              <a class="btn btn-light" href="/contatti">Compila il modulo</a>
              <a class="btn btn-ghost" href={waLink} target="_blank" rel="noopener noreferrer">Scrivi su WhatsApp</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <div class="buybar" data-buybar aria-hidden="true">
      <div><strong>{nome}</strong><small>Prezzo su richiesta</small></div>
      <a class="btn btn-primary" href={waLink} target="_blank" rel="noopener noreferrer" tabindex="-1">Ordina su WhatsApp</a>
    </div>

    <dialog class="lightbox" aria-label={`Foto ingrandita: ${nome}`} data-lightbox>
      <button type="button" class="lb-close" data-lb-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>Chiudi</button>
      <img src={torta.foto[0].src} alt="" data-lb-img />
      {torta.foto.length > 1 && (
        <>
          <button type="button" class="pg-btn pg-prev" aria-label="Foto precedente" data-lb-prev><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
          <button type="button" class="pg-btn pg-next" aria-label="Foto successiva" data-lb-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
        </>
      )}
      <span class="lb-caption" data-lb-caption></span>
    </dialog>

    <footer><div class="wrap">© 2026 Le Dolci Meraviglie di Lucy Garro · Torte artistiche, biscotti decorati e Sweet Table · Siracusa</div></footer>

    <a class="whatsapp-floating" href={waGenerico} target="_blank" rel="noopener noreferrer" aria-label="Contatta Lucia Garro su WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.7-1.2 2.2 2.2 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3Z"/></svg>
      <span>WhatsApp</span>
    </a>

    <script>
      /* ---------- menu mobile (come nelle altre pagine) ---------- */
      const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');

      const closeMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        mobileMenuToggle.setAttribute('aria-label', 'Apri menu di navigazione');
        mobileNav.classList.remove('is-open');
      };

      const openMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
        mobileMenuToggle.setAttribute('aria-label', 'Chiudi menu di navigazione');
        mobileNav.classList.add('is-open');
      };

      if (mobileMenuToggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
        mobileMenuToggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
          isOpen ? closeMobileMenu() : openMobileMenu();
        });
        mobileNav.addEventListener('click', (event) => {
          event.stopPropagation();
          if (event.target instanceof HTMLAnchorElement) closeMobileMenu();
        });
        document.addEventListener('click', closeMobileMenu);
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMobileMenu();
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 900) closeMobileMenu();
        });
      }

      /* ---------- card con doppia foto che si alterna ---------- */
      const SWAP_MS = 4000;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll('[data-cake-gallery]').forEach((gallery, galleryIndex) => {
        if (!(gallery instanceof HTMLElement)) return;
        const images = Array.from(gallery.querySelectorAll('img'));
        if (images.length < 2) return;

        const dots = Array.from(gallery.querySelectorAll('.gallery-dots button'));
        const label = gallery.querySelector('[data-photo-label]');
        let current = 0;
        let timer = 0;
        let visible = false;

        gallery.style.setProperty('--swap-ms', `${SWAP_MS}ms`);

        const show = (index) => {
          current = (index + images.length) % images.length;
          images.forEach((img, i) => img.classList.toggle('is-active', i === current));
          dots.forEach((dot, i) => dot.setAttribute('aria-pressed', i === current ? 'true' : 'false'));
          if (label) label.textContent = images[current].dataset.label ?? '';
        };

        const restartProgress = () => {
          gallery.classList.remove('is-running');
          void gallery.offsetWidth; // riavvia l'animazione della barra
          gallery.classList.add('is-running');
        };

        const stop = () => { window.clearInterval(timer); timer = 0; gallery.classList.remove('is-running'); };
        const start = () => {
          if (reduceMotion || timer || !visible) return;
          restartProgress();
          timer = window.setInterval(() => { show(current + 1); }, SWAP_MS);
        };

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            show(Number(dot.dataset.index ?? 0));
            stop();
            start();
          });
        });

        // le card partono sfalsate, e girano solo quando sono visibili
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            visible = entry.isIntersecting;
            if (visible) window.setTimeout(start, (galleryIndex % 3) * 700);
            else stop();
          });
        }, { threshold: 0.35 });
        observer.observe(gallery);
      });

      /* ---------- card prodotto: il clic porta alla pagina della torta ---------- */
      document.querySelectorAll('[data-cake-card]').forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        card.addEventListener('click', (event) => {
          // link, bottoni e pallini delle foto mantengono il loro comportamento
          if (event.target instanceof Element && event.target.closest('a, button, .gallery-dots')) return;
          if (card.dataset.href) window.location.href = card.dataset.href;
        });
      });

      /* ================= pagina prodotto ================= */

      /* ---------- carousel foto ---------- */
      const slides = Array.from(document.querySelectorAll('.pg-slide'));
      const track = document.querySelector('[data-track]');
      const stage = document.querySelector('[data-stage]');
      const thumbs = Array.from(document.querySelectorAll('[data-thumb]'));
      const slideLabel = document.querySelector('[data-pg-label]');
      const slideCurrent = document.querySelector('[data-pg-current]');
      let slideIndex = 0;

      const goTo = (index) => {
        if (!slides.length || !(track instanceof HTMLElement)) return;
        slideIndex = (index + slides.length) % slides.length;
        track.style.transform = `translateX(${-100 * slideIndex}%)`;
        slides.forEach((slide, i) => slide.setAttribute('aria-hidden', i === slideIndex ? 'false' : 'true'));
        thumbs.forEach((thumb, i) => thumb.setAttribute('aria-current', i === slideIndex ? 'true' : 'false'));
        if (slideLabel) slideLabel.textContent = slides[slideIndex].dataset.label ?? '';
        if (slideCurrent) slideCurrent.textContent = String(slideIndex + 1);
      };
      goTo(0);

      document.querySelector('[data-prev]')?.addEventListener('click', () => goTo(slideIndex - 1));
      document.querySelector('[data-next]')?.addEventListener('click', () => goTo(slideIndex + 1));
      thumbs.forEach((thumb) => thumb.addEventListener('click', () => goTo(Number(thumb.dataset.thumb ?? 0))));

      if (stage instanceof HTMLElement) {
        stage.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(slideIndex - 1); }
          if (event.key === 'ArrowRight') { event.preventDefault(); goTo(slideIndex + 1); }
        });
        // scorrimento con il dito
        let touchX = null;
        stage.addEventListener('touchstart', (event) => { touchX = event.touches[0].clientX; }, { passive: true });
        stage.addEventListener('touchend', (event) => {
          if (touchX === null) return;
          const dx = event.changedTouches[0].clientX - touchX;
          touchX = null;
          if (Math.abs(dx) > 40) goTo(slideIndex + (dx < 0 ? 1 : -1));
        });
      }

      /* ---------- foto ingrandita (lightbox) ---------- */
      const lightbox = document.querySelector('[data-lightbox]');
      if (lightbox instanceof HTMLDialogElement) {
        const lbImg = lightbox.querySelector('[data-lb-img]');
        const lbCaption = lightbox.querySelector('[data-lb-caption]');
        const renderLightbox = () => {
          const img = slides[slideIndex]?.querySelector('img');
          if (!(img instanceof HTMLImageElement) || !(lbImg instanceof HTMLImageElement)) return;
          lbImg.src = img.currentSrc || img.src;
          lbImg.alt = img.alt;
          if (lbCaption) lbCaption.textContent = `${slides[slideIndex].dataset.label ?? ''} · ${slideIndex + 1} / ${slides.length}`;
        };
        const openLightbox = () => {
          renderLightbox();
          document.documentElement.style.overflow = 'hidden';
          lightbox.showModal();
        };
        const step = (delta) => { goTo(slideIndex + delta); renderLightbox(); };

        document.querySelector('[data-zoom]')?.addEventListener('click', openLightbox);
        document.querySelectorAll('[data-zoom-img]').forEach((img) => img.addEventListener('click', openLightbox));
        lightbox.querySelector('[data-lb-close]')?.addEventListener('click', () => lightbox.close());
        lightbox.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
        lightbox.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));
        lightbox.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
        lightbox.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') step(-1);
          if (event.key === 'ArrowRight') step(1);
        });
        lightbox.addEventListener('close', () => {
          document.documentElement.style.overflow = '';
          if (stage instanceof HTMLElement) stage.focus({ preventScroll: true });
        });
      }

      /* ---------- condividi ---------- */
      const shareBtn = document.querySelector('[data-share]');
      const shareStatus = document.querySelector('[data-share-status]');
      if (shareBtn instanceof HTMLButtonElement) {
        shareBtn.addEventListener('click', async () => {
          const data = { title: shareBtn.dataset.title ?? document.title, url: window.location.href };
          if (navigator.share) {
            try { await navigator.share(data); } catch { /* condivisione annullata */ }
            return;
          }
          try {
            await navigator.clipboard.writeText(data.url);
            if (shareStatus) shareStatus.textContent = 'Link copiato!';
          } catch {
            if (shareStatus) shareStatus.textContent = 'Copia il link dalla barra degli indirizzi.';
          }
          window.setTimeout(() => { if (shareStatus) shareStatus.textContent = ''; }, 3000);
        });
      }

      /* ---------- recensione con stelline (inviata a Lucia su WhatsApp) ---------- */
      const reviewForm = document.querySelector('[data-review-form]');
      if (reviewForm instanceof HTMLFormElement) {
        const hint = reviewForm.querySelector('[data-star-hint]');
        const status = reviewForm.querySelector('[data-form-status]');
        const chars = reviewForm.querySelector('[data-chars]');
        const testo = reviewForm.querySelector('[data-testo]');
        const giudizi = ['', 'Pessima', 'Scarsa', 'Nella media', 'Molto buona', 'Eccellente!'];

        reviewForm.querySelectorAll('input[name="voto"]').forEach((radio) => {
          radio.addEventListener('change', () => {
            if (hint && radio instanceof HTMLInputElement) hint.textContent = giudizi[Number(radio.value)] ?? '';
          });
        });
        if (testo instanceof HTMLTextAreaElement && chars) {
          testo.addEventListener('input', () => { chars.textContent = String(testo.value.length); });
        }

        reviewForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const dati = new FormData(reviewForm);
          const voto = Number(dati.get('voto') ?? 0);
          const nome = String(dati.get('nome') ?? '').trim();
          const recensione = String(dati.get('testo') ?? '').trim();
          const say = (msg) => { if (status) status.textContent = msg; };

          if (!voto) return say('Scegli un voto da 1 a 5 stelle.');
          if (nome.length < 2) return say('Inserisci il tuo nome.');
          if (recensione.length < 10) return say('Scrivi almeno qualche parola sulla torta (minimo 10 caratteri).');
          if (!dati.get('consenso')) return say('Per inviare la recensione serve il consenso alla pubblicazione.');

          const stelle = '★'.repeat(voto) + '☆'.repeat(5 - voto);
          const messaggio = [
            `Ciao Lucia, ecco la mia recensione per la "${reviewForm.dataset.torta ?? ''}":`,
            '',
            `Voto: ${stelle} (${voto}/5)`,
            `Nome: ${nome}`,
            '',
            recensione,
            '',
            `Pagina: ${window.location.href}`,
            'Acconsento alla pubblicazione con il mio nome.',
          ].join('\n');
          window.open(`https://wa.me/393519425808?text=${encodeURIComponent(messaggio)}`, '_blank', 'noopener');
          say('Grazie! Si è aperto WhatsApp con la tua recensione: premi Invia per mandarla a Lucia.');
          reviewForm.reset();
          if (hint) hint.textContent = '';
          if (chars) chars.textContent = '0';
        });
      }

      /* ---------- barra "Ordina" fissa su mobile quando i bottoni principali non sono visibili ---------- */
      const buybar = document.querySelector('[data-buybar]');
      const buyActions = document.querySelector('.buy-actions');
      if (buybar instanceof HTMLElement && buyActions) {
        const buybarLink = buybar.querySelector('a');
        new IntersectionObserver(([entry]) => {
          const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          buybar.classList.toggle('is-visible', show);
          buybar.setAttribute('aria-hidden', show ? 'false' : 'true');
          buybarLink?.setAttribute('tabindex', show ? '0' : '-1');
        }).observe(buyActions);
      }
    </script>
  </body>
</html>
