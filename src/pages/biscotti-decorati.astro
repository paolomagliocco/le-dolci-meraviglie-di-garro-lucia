---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index,follow" />

    <style>
      :root {
        --cream: #fffaf5;
        --paper: #ffffff;
        --ink: #302820;
        --muted: #786b60;
        --rose-dark: #b76773;
        --beige: #efe4d7;
        --line: #eadfd5;
        --shadow: 0 14px 40px rgba(72, 48, 34, .08);
      }

      * { box-sizing: border-box; }
      body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); background: var(--cream); line-height: 1.6; }
      a { color: inherit; text-decoration: none; }
      .wrap { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }

      header { position: sticky; top: 0; z-index: 20; background: rgba(255,250,245,.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
      .brand { font-family: Georgia, serif; font-size: 1.25rem; font-weight: 700; }
      .brand span { color: var(--rose-dark); }
      nav { display: flex; gap: 22px; font-size: .95rem; }

      .mobile-menu-toggle {
        display: none; width: 46px; height: 46px; flex: 0 0 46px;
        align-items: center; justify-content: center; padding: 0;
        border: 1px solid var(--line); border-radius: 14px;
        background: #fff; color: var(--ink); cursor: pointer;
        box-shadow: 0 8px 22px rgba(72,48,34,.08);
      }
      .mobile-menu-toggle span,
      .mobile-menu-toggle span::before,
      .mobile-menu-toggle span::after {
        display: block; width: 22px; height: 2px; border-radius: 2px;
        background: currentColor; transition: transform .2s ease, opacity .2s ease;
      }
      .mobile-menu-toggle span { position: relative; }
      .mobile-menu-toggle span::before,
      .mobile-menu-toggle span::after { content: ""; position: absolute; left: 0; }
      .mobile-menu-toggle span::before { top: -7px; }
      .mobile-menu-toggle span::after { top: 7px; }
      .mobile-menu-toggle[aria-expanded="true"] span { background: transparent; }
      .mobile-menu-toggle[aria-expanded="true"] span::before { top: 0; transform: rotate(45deg); }
      .mobile-menu-toggle[aria-expanded="true"] span::after { top: 0; transform: rotate(-45deg); }
      .mobile-nav-panel { display: none; }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 999px; padding: 13px 20px; font-weight: 700; transition: .2s ease; }
      .btn:hover { transform: translateY(-2px); }
      .btn-primary { background: var(--rose-dark); color: white; }

      .hero { padding: 82px 0 54px; text-align: center; }
      .eyebrow { display: inline-block; background: var(--beige); padding: 7px 12px; border-radius: 999px; font-size: .82rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
      h1, h2, h3 { font-family: Georgia, serif; line-height: 1.1; margin-top: 0; }
      h1 { font-size: clamp(2.8rem, 6vw, 5rem); margin: 18px auto; max-width: 900px; }
      h1 em { color: var(--rose-dark); font-style: normal; }
      .lead { max-width: 840px; margin: 0 auto; color: var(--muted); font-size: 1.1rem; }

      .catalogo { padding: 30px 0 84px; }
      .products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

      .product-card { min-width: 0; overflow: hidden; display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: 26px; box-shadow: var(--shadow); }
      .product-image { width: 100%; height: 275px; overflow: hidden; background: #f6eee8; }
      .product-image img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .3s ease; }
      .product-card:hover .product-image img { transform: scale(1.025); }

      .product-body { display: flex; flex: 1; flex-direction: column; padding: 24px; }
      .category { color: var(--rose-dark); font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
      .product-body h2 { font-size: 1.55rem; margin: 8px 0 12px; }
      .product-body p { color: var(--muted); margin: 0 0 22px; }

      .product-actions { margin-top: auto; display: flex; gap: 10px; flex-wrap: wrap; }
      .etsy-btn { background: var(--rose-dark); color: white; }
      .whatsapp-btn { background: white; border: 1px solid var(--line); }

      .product-card {
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease;
      }

      .product-card *,
      .product-card .product-image,
      .product-card h2 {
        cursor: pointer;
      }

      .product-card a,
      .product-card button {
        cursor: pointer;
      }

      .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 46px rgba(72, 48, 34, .13);
      }

      .product-card:focus-visible {
        outline: 3px solid rgba(183,103,115,.35);
        outline-offset: 3px;
      }

      .product-modal {
        position: relative;
        width: min(980px, calc(100% - 32px));
        max-height: 90vh;
        padding: 0;
        border: 0;
        border-radius: 28px;
        overflow: hidden;
        background: var(--paper);
        color: var(--ink);
        box-shadow: 0 30px 90px rgba(31, 20, 14, .28);
      }

      .product-modal::backdrop {
        background: rgba(36, 27, 23, .68);
        backdrop-filter: blur(5px);
      }

      .modal-grid {
        display: grid;
        grid-template-columns: 1.08fr .92fr;
        min-height: 560px;
      }

      .modal-image-wrap {
        min-width: 0;
        min-height: 560px;
        background: #f6eee8;
        display: grid;
        place-items: center;
        overflow: hidden;
      }

      .modal-image-wrap img {
        width: 100%;
        height: 100%;
        max-height: 78vh;
        display: block;
        object-fit: contain;
      }

      .modal-content {
        position: relative;
        padding: 48px 40px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .modal-content h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin: 10px 0 16px;
      }

      .modal-content p {
        color: var(--muted);
        font-size: 1.05rem;
        margin: 0;
      }

      .modal-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
      }

      .modal-close {
        position: absolute;
        top: 18px;
        right: 18px;
        z-index: 20;
        width: 46px;
        height: 46px;
        display: grid;
        place-items: center;
        padding: 0;
        border: 2px solid rgba(255,255,255,.9);
        border-radius: 50%;
        background: var(--rose-dark);
        color: white;
        font-family: Arial, sans-serif;
        font-size: 1.75rem;
        font-weight: 400;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(48, 40, 32, .22);
        transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
      }

      .modal-close:hover {
        transform: scale(1.08);
        background: #9f5561;
        box-shadow: 0 10px 28px rgba(48, 40, 32, .28);
      }

      .modal-close:focus-visible {
        outline: 3px solid rgba(183,103,115,.30);
        outline-offset: 3px;
      }

      .info-box { margin-top: 56px; padding: 38px; border-radius: 30px; background: #f4ece4; text-align: center; }
      .info-box h2 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 12px; }
      .info-box p { max-width: 760px; margin: 0 auto 22px; color: var(--muted); }

      footer { padding: 40px 0 56px; color: var(--muted); font-size: .9rem; }

      .whatsapp-floating { position: fixed; right: 24px; bottom: 24px; z-index: 1000; display: flex; align-items: center; gap: 10px; padding: 14px 20px; border-radius: 999px; background: #25D366; color: white; font-weight: 800; box-shadow: 0 10px 30px rgba(0,0,0,.20); }

      @media (max-width: 900px) {
        .nav { min-height: 76px; gap: 14px; }
        .nav > nav, .nav > .btn-primary { display: none; }
        .brand { min-width: 0; font-size: clamp(1rem, 4vw, 1.25rem); line-height: 1.2; }
        .mobile-menu-toggle { display: inline-flex; margin-left: auto; }

        .mobile-nav-panel {
          display: block; position: absolute; top: calc(100% + 8px);
          left: 16px; right: 16px; padding: 12px;
          border: 1px solid var(--line); border-radius: 22px;
          background: rgba(255,250,245,.99);
          box-shadow: 0 22px 54px rgba(72,48,34,.18);
          transform: translateY(-8px); opacity: 0; visibility: hidden;
          pointer-events: none;
          transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
        }
        .mobile-nav-panel.is-open {
          transform: translateY(0); opacity: 1; visibility: visible; pointer-events: auto;
        }
        .mobile-nav-panel nav { display: grid; gap: 4px; }
        .mobile-nav-panel nav a {
          display: block; padding: 13px 14px; border-radius: 14px;
          font-size: 1rem; font-weight: 700;
        }
        .mobile-nav-panel nav a:hover,
        .mobile-nav-panel nav a:focus-visible { background: var(--beige); outline: none; }
        .mobile-nav-panel .mobile-etsy { width: 100%; margin-top: 10px; }

        .products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }

      @media (max-width: 600px) {
        .hero { padding-top: 56px; }
        .products { grid-template-columns: 1fr; }
        .product-image { height: 250px; }
        .whatsapp-floating { right: 16px; bottom: 16px; padding: 12px 16px; }

        .product-modal {
          width: calc(100% - 20px);
          max-height: 94vh;
          border-radius: 22px;
        }

        .modal-grid {
          grid-template-columns: 1fr;
          min-height: auto;
        }

        .modal-image-wrap {
          min-height: 280px;
          height: 42vh;
        }

        .modal-content {
          padding: 28px 22px 24px;
        }

        .modal-actions {
          flex-direction: column;
        }

        .modal-actions .btn {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="wrap nav">
