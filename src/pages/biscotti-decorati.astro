    <a
      class="whatsapp-floating"
      href="https://wa.me/393519425808?text=Ciao%20Lucia%2C%20vorrei%20avere%20informazioni%20sui%20biscotti%20decorati%20personalizzati."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contatta Lucia Garro su WhatsApp"
    >
      WhatsApp
    </a>

    <script>
      const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');

      const closeMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        mobileMenuToggle.setAttribute('aria-label', 'Apri menu di navigazione');
        mobileNav.classList.remove('is-open');
      };

      const openMobileMenu = () => {
        if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
        mobileMenuToggle.setAttribute('aria-label', 'Chiudi menu di navigazione');
        mobileNav.classList.add('is-open');
      };

      if (mobileMenuToggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
        mobileMenuToggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
          isOpen ? closeMobileMenu() : openMobileMenu();
        });
        mobileNav.addEventListener('click', (event) => {
          event.stopPropagation();
          if (event.target instanceof HTMLAnchorElement) closeMobileMenu();
        });
        document.addEventListener('click', closeMobileMenu);
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMobileMenu();
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 900) closeMobileMenu();
        });
      }

      const modal = document.querySelector('#product-modal');
      const cards = document.querySelectorAll('[data-product-card]');
      const modalImage = document.querySelector('#modal-image');
      const modalTitle = document.querySelector('#modal-title');
      const modalCategory = document.querySelector('#modal-category');
      const modalDescription = document.querySelector('#modal-description');
      const modalEtsy = document.querySelector('#modal-etsy');
      const modalWhatsapp = document.querySelector('#modal-whatsapp');
      const closeButton = document.querySelector('.modal-close');

      function openProductModal(card) {
        const title = card.dataset.title ?? '';
        const category = card.dataset.category ?? '';
        const description = card.dataset.description ?? '';
        const image = card.dataset.image ?? '';
        const etsy = card.dataset.etsy ?? 'https://www.etsy.com/';

        modalImage.src = image;
        modalImage.alt = `${title} - immagine ingrandita`;

        modalTitle.textContent = title;
        modalCategory.textContent = category;
        modalDescription.textContent = description;
        modalEtsy.href = etsy;

        const whatsappMessage = encodeURIComponent(
          `Ciao Lucia, vorrei avere informazioni su: ${title}`
        );
        modalWhatsapp.href = `https://wa.me/393519425808?text=${whatsappMessage}`;

        modal.showModal();
      }

      cards.forEach((card) => {
        card.addEventListener('click', (event) => {
          if (event.target.closest('a')) return;
          openProductModal(card);
        });

        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openProductModal(card);
          }
        });
      });

      closeButton?.addEventListener('click', () => {
        modal.close();
      });

      modal?.addEventListener('click', (event) => {
        if (event.target === modal) {
          modal.close();
        }
      });
    </script>

  </body>
</html>
