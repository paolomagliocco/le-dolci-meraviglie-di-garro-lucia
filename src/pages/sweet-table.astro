---
const seoTitle = 'Sweet Table Personalizzati per Eventi | Lucia Garro';
const seoDescription = 'Scopri sweet table personalizzati con biscotti decorati per compleanni, battesimi, baby shower, gender reveal, comunioni, cresime, matrimoni, nascite ed eventi.';
const canonicalUrl = 'https://www.ledolcimeravigliedigarrolucia.com/sweet-table';
const etsyUrl = 'https://sweetwondersoflucy.etsy.com';
const ogImage = 'https://www.ledolcimeravigliedigarrolucia.com/images/sweet-table-con-biscotti-decorati-a-tema-rose-e-cuori.png';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sweet Table personalizzati per eventi',
  url: canonicalUrl,
  description: seoDescription,
  image: ogImage,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Le Dolci Meraviglie di Lucy Garro',
    url: 'https://www.ledolcimeravigliedigarrolucia.com/'
  },
  about: {
    '@type': 'Thing',
    name: 'Sweet table personalizzati'
  }
};

const prodotti = [
  { titolo:'Sweet Table a tema Fiorito', categoria:'Compleanno', descrizione:'Allestimento coordinato con biscotti decorati e dettagli floreali, ideale per compleanni ed eventi dallo stile delicato.', immagine:'/images/sweet-table-con-biscotti-a-tema-fiorito.png', etsy:etsyUrl },
  { titolo:'Sweet Table Rose e Cuori', categoria:'Matrimonio / Evento', descrizione:'Sweet table romantico con biscotti decorati a tema rose e cuori, ideale per matrimoni, anniversari e occasioni speciali.', immagine:'/images/sweet-table-con-biscotti-decorati-a-tema-rose-e-cuori.png', etsy:etsyUrl },
  { titolo:'Sweet Table Stelle Marine', categoria:'Compleanno', descrizione:'Allestimento a tema mare con stelle marine e biscotti decorati coordinati, perfetto per feste estive e compleanni.', immagine:'/images/sweet-table-con-biscotti-decorati-a-tema-stelle-marine.png', etsy:etsyUrl },
  { titolo:'Sweet Table a tema Sirenetta', categoria:'Compleanno', descrizione:'Sweet table a tema sirenetta con biscotti decorati e dettagli ispirati al mondo marino.', immagine:'/images/sweet-table-biscotti-a-tema-sirenetta.png', etsy:etsyUrl },
  { titolo:'Sweet Table a tema Unicorno', categoria:'Compleanno', descrizione:'Allestimento coordinato a tema unicorno con biscotti decorati e dettagli personalizzati.', immagine:'/images/sweet-table-biscotti-a-tema-unicorno.png', etsy:etsyUrl },
  { titolo:'Sweet Table Baby Shower con orsetti azzurri', categoria:'Baby Shower', descrizione:'Sweet table nei toni dell’azzurro con orsetti e biscotti decorati, ideale per baby shower e nascita.', immagine:'/images/sweet-table-biscotti-baby-shower-orsetti-azzurri.png', etsy:etsyUrl },
  { titolo:'Sweet Table Comunione e Cresima', categoria:'Comunione e Cresima', descrizione:'Allestimento elegante con biscotti decorati coordinati per Comunione e Cresima.', immagine:'/images/sweet-table-biscotti-comunione-cresima.png', etsy:etsyUrl },
  { titolo:'Sweet Table I Tesori del Mare', categoria:'Compleanno', descrizione:'Allestimento ispirato ai tesori del mare con biscotti decorati e dettagli marini coordinati.', immagine:'/images/sweet-table-biscotti-decorati-a-tema-i-tesori-del-mare.png', etsy:etsyUrl },
  { titolo:'Sweet Table a tema Angeli', categoria:'Battesimo', descrizione:'Sweet table delicato a tema angeli, ideale per battesimi e cerimonie.', immagine:'/images/sweet-table-biscotti-decorati-a-tema-angeli.png', etsy:etsyUrl },
  { titolo:'Sweet Table Siciliano con maioliche e limoni', categoria:'Matrimonio / Evento', descrizione:'Allestimento ispirato alla Sicilia con maioliche, limoni e biscotti decorati coordinati.', immagine:'/images/sweet-table-biscotti-decorati-a-tema-siciliano-con-maioliche-e-limoni.png', etsy:etsyUrl },
  { titolo:'Sweet Table Gender Reveal con orsetti Boy or Girl', categoria:'Gender Reveal', descrizione:'Allestimento rosa e azzurro con orsetti per Gender Reveal e Baby Shower.', immagine:'/images/sweet-table-biscotti-decorati-Gender-Reveal-con-orsetti-boy-or-girl.png', etsy:etsyUrl },
  { titolo:'Sweet Table 18° compleanno floreale', categoria:'Compleanno', descrizione:'Sweet table elegante e floreale per festeggiare il diciottesimo compleanno con uno stile raffinato.', immagine:'/images/sweet-table-biscotti-decorati-per-18-esimo-compleanno-a-tema-floreale.png', etsy:etsyUrl },
  { titolo:'Sweet Table Animali della Fattoria', categoria:'Compleanno', descrizione:'Allestimento con animali della fattoria e biscotti decorati coordinati per feste dei più piccoli.', immagine:'/images/sweet-table-biscotti-decorati-per-compleanno-a-tema-animali-della-fattoria.png', etsy:etsyUrl },
  { titolo:'Sweet Table Animali della Giungla', categoria:'Compleanno', descrizione:'Sweet table a tema giungla e safari con biscotti decorati personalizzati.', immagine:'/images/sweet-table-biscotti-decorati-per-compleanno-a-tema-animali-della-giungla.png', etsy:etsyUrl },
  { titolo:'Sweet Table Animali Marini', categoria:'Compleanno', descrizione:'Allestimento a tema oceano con animali marini e biscotti decorati coordinati.', immagine:'/images/sweet-table-biscotti-decorati-per-compleanno-a-tema-animali-marini.png', etsy:etsyUrl },
  { titolo:'Sweet Table Arcobaleno', categoria:'Compleanno', descrizione:'Sweet table colorato a tema arcobaleno con biscotti decorati e dettagli pastello.', immagine:'/images/sweet-table-biscotti-decorati-per-compleanno-a-tema-arcobaleno.png', etsy:etsyUrl },
  { titolo:'Sweet Table Unicorno', categoria:'Compleanno', descrizione:'Allestimento a tema unicorno con biscotti decorati e dettagli coordinati.', immagine:'/images/sweet-table-biscotti-decorati-per-compleanno-a-tema-unicorno.png', etsy:etsyUrl },
  { titolo:'Sweet Table Unicorno Rosa', categoria:'Compleanno', descrizione:'Sweet table a tema unicorno rosa per una festa fiabesca e delicata.', immagine:'/images/sweet-table-biscotti-decorati-per-compleanno-a-tema-unicorno-rosa.png', etsy:etsyUrl },
  { titolo:'Sweet Table Cuore e Rose', categoria:'Matrimonio / Evento', descrizione:'Allestimento romantico con cuore, rose e biscotti decorati per eventi e ricorrenze.', immagine:'/images/sweet-table-biscotti-decorati-per-eventi-con-cuore-e-rose.png', etsy:etsyUrl },
  { titolo:'Sweet Table Matrimonio a tema Nuziale', categoria:'Matrimonio', descrizione:'Sweet table nuziale coordinato con biscotti decorati e dettagli personalizzati.', immagine:'/images/sweet-table-biscotti-decorati-per-matrimonio-a-tema-nuziale.png', etsy:etsyUrl },
  { titolo:'Sweet Table nascita bambino con orsetti', categoria:'Nascita', descrizione:'Allestimento con orsetti per la nascita di un bambino, con biscotti decorati coordinati.', immagine:'/images/sweet-table-biscotti-decorati-per-nascita-bambino-con-orsetti.png', etsy:etsyUrl },
  { titolo:'Sweet Table Cuore e Rose Rosa', categoria:'Matrimonio / Evento', descrizione:'Allestimento personalizzato con rose rosa e cuori per eventi romantici.', immagine:'/images/sweet-table-biscotti-decorati-personalizzati-a-tema-cuore-e-rose-rosa.png', etsy:etsyUrl },
  { titolo:'Sweet Table Cresima con fiori', categoria:'Comunione e Cresima', descrizione:'Sweet table floreale per Cresima con biscotti decorati coordinati.', immagine:'/images/sweet-table-biscotti-decorati-personalizzati-per-Cresima-con-fiori.png', etsy:etsyUrl },
  { titolo:'Sweet Table primo compleanno Caramelle', categoria:'Compleanno', descrizione:'Allestimento colorato a tema caramelle per festeggiare il primo compleanno.', immagine:'/images/sweet-table-biscotti-decorati-primo-compeanno-a-tema-caramelle.png', etsy:etsyUrl },
  { titolo:'Sweet Table primo compleanno Foglie d’Autunno', categoria:'Compleanno', descrizione:'Sweet table dai toni autunnali con biscotti decorati per il primo compleanno.', immagine:'/images/sweet-table-biscotti-decorati-primo-compleanno-a-tema-foglie-di-autunno.png', etsy:etsyUrl },
  { titolo:'Sweet Table primo compleanno rosa con fiocchi', categoria:'Compleanno', descrizione:'Allestimento rosa con fiocchi e biscotti decorati per il primo compleanno.', immagine:'/images/sweet-table-biscotti-decorati-primo-compleanno-rosa-con-fiocchi.png', etsy:etsyUrl },
  { titolo:'Sweet Table Gender Reveal New Born', categoria:'Gender Reveal', descrizione:'Allestimento rosa e azzurro per Gender Reveal e nascita con biscotti decorati coordinati.', immagine:'/images/sweet-table-biscotti-gender-reveal-new-born.png', etsy:etsyUrl },
  { titolo:'Sweet Table Gender Reveal con orsetti', categoria:'Gender Reveal', descrizione:'Sweet table personalizzato con orsetti, dettagli rosa e azzurri e biscotti decorati.', immagine:'/images/sweet-table-biscotti-gender-reveal-orsetti.png', etsy:etsyUrl },
  { titolo:'Sweet Table New Born Girl', categoria:'Nascita', descrizione:'Sweet table per la nascita di una bambina con palette rosa e biscotti decorati coordinati.', immagine:'/images/sweet-table-biscotti-new-born-girl.png', etsy:etsyUrl },
  { titolo:'Sweet Table Battesimo con orsetti azzurri', categoria:'Battesimo', descrizione:'Allestimento per battesimo con orsetti azzurri, biscotti decorati e dettagli personalizzati.', immagine:'/images/sweet-table-biscotti-orsetti-azzurri-battesimo.png', etsy:etsyUrl },
  { titolo:'Sweet Table a tema Piccolo Principe', categoria:'Compleanno', descrizione:'Sweet table ispirato al Piccolo Principe con biscotti decorati e allestimento coordinato.', immagine:'/images/sweet-table-biscotti-piccolo-principe.png', etsy:etsyUrl },
  { titolo:'Sweet Table primo complimese con orsetti', categoria:'Baby Shower / Complimese', descrizione:'Allestimento con orsetti per festeggiare il primo complimese con biscotti decorati coordinati.', immagine:'/images/sweet-table-con-biscotti-e-orsetti-primo-complimese.png', etsy:etsyUrl },
];
